+    /// `array<u32, 1>`, the type of the `SampleMask` built-in's variables
+    /// (`ty` is their `u32`).
+    fn get_sample_mask_array_type_id(&mut self, ty: Handle<crate::Type>) -> Word {
+        if let Some(id) = self.sample_mask_array_type {
+            return id;
+        }
+        let base_id = self.get_handle_type_id(ty);
+        let length_id = self.get_index_constant(1);
+        let id = self.id_gen.next();
+        Instruction::type_array(id, base_id, length_id)
+            .to_words(&mut self.logical_layout.declarations);
+        self.sample_mask_array_type = Some(id);
+        id
+    }
+
+    /// The pointer an IO variable is loaded from or stored to: itself, or
+    /// for a `SampleMask` variable, its first element.
+    fn io_pointer(&mut self, body: &mut Vec<Instruction>, varying_id: Word) -> Word {
+        let Some(class) = self.sample_mask_vars.get(&varying_id).copied() else {
+            return varying_id;
+        };
+        let u32_id = self.get_u32_type_id();
+        let pointer_type_id = self.get_pointer_type_id(u32_id, class);
+        let zero_id = self.get_index_constant(0);
+        let id = self.id_gen.next();
+        body.push(Instruction::access_chain(
+            pointer_type_id,
+            id,
+            varying_id,
+            &[zero_id],
+        ));
+        id
+    }
