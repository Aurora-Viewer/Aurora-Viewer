<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream data of the Flatpak (docs/LINUX.md, "Flatpak"). The
     releases element is filled by scripts/package-flatpak.sh with the
     version it packages. -->
<component type="desktop-application">
  <id>org.aurora_viewer.AuroraViewer</id>
  <name>Aurora Viewer</name>
  <summary>A modern Second Life viewer</summary>
  <developer id="org.aurora_viewer">
    <name>Aurora Viewer contributors</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Aurora Viewer is a viewer for Second Life, written in Rust with a
      Vulkan renderer: parallel loading, fast teleports and a clean
      interface, with the features of the viewers you already know.
    </p>
    <p>
      This software is not provided or supported by Linden Lab, the makers
      of Second Life.
    </p>
  </description>
  <launchable type="desktop-id">org.aurora_viewer.AuroraViewer.desktop</launchable>
  <provides>
    <binary>aurora-viewer</binary>
  </provides>
  <url type="homepage">https://aurora-viewer.org</url>
  <url type="bugtracker">https://github.com/Aurora-Viewer/Aurora-Viewer/issues</url>
  <url type="vcs-browser">https://github.com/Aurora-Viewer/Aurora-Viewer</url>
  <categories>
    <category>Game</category>
    <category>Simulation</category>
  </categories>
  <requires>
    <internet>always</internet>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
    <content_attribute id="money-purchasing">intense</content_attribute>
  </content_rating>
  <releases>
  </releases>
</component>
