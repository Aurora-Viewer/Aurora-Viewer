{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aurora-viewer:extension-manifest:v1",
  "title": "Aurora extension manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "api",
    "entry",
    "permissions",
    "publisher"
  ],
  "properties": {
    "manifest_version": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "api": { "type": "string", "minLength": 1, "maxLength": 128 },
    "entry": { "const": "module.wasm" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "chat.nearby.read",
          "ui.chat.annotate",
          "ui.panel.register",
          "ui.notification.show"
        ]
      }
    },
    "network_domains": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }
  }
}
