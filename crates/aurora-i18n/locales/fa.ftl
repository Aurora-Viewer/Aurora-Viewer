    { $count ->
        [one] { $count } لباس هنوز عکسي نداره
       *[other] { $count } لباس ها هنوز عکس ندارن
    }
ui-appearance-batch-open = عکسها رو بگير
ui-appearance-showcase-dismiss = مخفی کردن این پیام
