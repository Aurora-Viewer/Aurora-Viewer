cli-help = { "Aurora Viewer\u000A\u000AUso: aurora-viewer [--title <texto>] [--fps-limit <fps>] [--language <código>] [--grid <nome>]\u000A                     [--login <nome> <sobrenome> <senha>] [--version] [<slurl>]\u000A\u000A  --title <texto>   Dá um nome a esta janela (\"Aurora Viewer <versão> - <texto>\") e ao seu registro\u000A                   (aurora-<texto>.log, aurora-demo-<texto>.log no modo demonstração)\u000A  --fps-limit <fps>  Limita este processo a 1..500 FPS sem salvar as preferências\u000A  --language <código>  Altera o idioma da interface apenas deste processo (" }{ $languages }{ ")\u000A  --grid <nome>    Inicia em agni, aditi, o nome de uma grade salva ou um URI de login (também --loginuri <uri>)\u000A  --login <nome> <sobrenome> <senha>  Entra imediatamente com esta conta\u000A  <slurl>, --url <slurl>  Inicia neste local; o que vier depois não é lido. Um visualizador\u000A                   já aberto recebe o local em vez disso\u000A  -V, --version   Mostra a versão compilada do visualizador sem iniciá-lo\u000A  -h, --help       Mostra esta ajuda\u000A\u000AAs chaves de teste são variáveis de ambiente (AURORA_DEMO=1, AURORA_CAPTURE=...):\u000Aveja README.md." }
demo-media-page = { "data:text/html;charset=utf-8,<html><body style='margin:0;height:100vh;background:linear-gradient(135deg,%232a1f4a,%230f6d6d);color:white;font:56px sans-serif;text-align:center'><h1 style='margin:40px 0 10px'>Mídia do Aurora</h1><p id='t' style='font-size:90px;margin:10px'>--</p><button onclick=\"document.body.style.background='%237a3b9c';this.textContent='Clicado!'\" style='font-size:48px;padding:10px 40px'>Clique</button><br><input placeholder='Digite aqui' style='font-size:44px;margin-top:30px;width:70%'><script>setInterval(function(){document.getElementById('t').textContent=new Date().toLocaleTimeString()},250)</script></body></html>" }

