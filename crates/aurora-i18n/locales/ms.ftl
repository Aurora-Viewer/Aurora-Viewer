# Director — capture and animations
director-capture = Laluan secara manual
director-capture-start = Rekod laluan saya
director-capture-start-tip = Terbangkan kamera seperti anda mahu ia dirakam (kamera-alter, kamera bebas atau flycam): paparan disimpan dua puluh kali sesaat, dan Stop mengubahnya ke dalam bingkai kunci pada kelajuan yang anda terbang.
director-capture-taking =
    Menyalin laluan anda: { $time }, { $views ->
        [one] { $views } Paparan
       *[other] { $views } paparan
    }
director-capture-stop = Hentikan dan buat keyframes
director-capture-stop-tip = Laluan menjadi keyframes selepas akhir trek, pada kadar yang anda terbangkannya. Ctrl+Z mengambilnya semula.
director-capture-cancel-tip = Buang laluan ini (Escape).
director-capture-detail = Perincian
director-capture-detail-tip = Berapa rapat kerangka kunci mengikuti laluan anda: lebih perincian menyimpan pergerakan yang lebih kecil, dengan lebih kerangka kekunci.
director-capture-hint = Laluan anda ditambah selepas penghujung trek, atau menjadi trek apabila ia kosong.
director-capture-done =
    Laluan kamu menjadi { $count ->
        [one] { $count } keyframe
       *[other] { $count } keyframes
    } atas { $time }.
director-capture-short = Laluan terlalu pendek untuk dimainkan: rakam lebih lama.
director-capture-full = Trek tidak mempunyai ruang untuk laluan ini.
director-capture-dropped = Laluan telah digugurkan: Pengarah ditutup, teleport bermula atau RLVa membatasi kamera.
director-capture-restricted = RLVa membatasi kamera: tiada laluan boleh direkodkan.
director-key-anim = Animasi
director-key-anim-none = Tiada
director-key-anim-tip = Animasi inventori anda yang avatar anda mainkan bila trek melepasi keyframe ini (atau jatuhkan satu di sini dari inventori). Apapun trek mula berhenti bila mainan berakhir.
director-key-anim-missing = { $name } (hilang)
director-key-anim-missing-tip = Animasi ini tidak lagi dalam inventori anda: main balik melepasinya.
director-key-anim-clear = Tiada animasi di sini
director-key-anim-until = Hingga
director-key-anim-until-tip = Di mana animasi berhenti: pada keyframe kemudian, atau bila main balik berakhir.
director-key-anim-end = Akhir main balik
director-key-anim-stops = Henti
director-key-anim-stops-tip = Animasi yang bingkai kunci awal mula berhenti di sini.
director-key-anim-stops-clear = Biarkan ia bermain
director-key-lens-time = Lensa dan masa hari
director-key-aperture = Bukaan
director-key-aperture-tip = Kedalaman medan bingkai kunci ini; antara dua bingkai kekunci ia berubah dengan lancar.
director-key-focus = Fokus
director-key-focus-tip = Jarak kerangka kunci ini difokuskan pada, bukannya trek (sasaran, atau jarak fokusnya).
director-key-hour = Masa hari
director-key-hour-tip = Matahari pada kerangka kunci ini, pada pandangan anda sahaja: tiada apa yang dihantar ke kawasan. Antara dua kerangka kekunci ia bergerak dengan lancar; langit anda sendiri kembali apabila main balik berakhir.
director-key-track-value = Nilai trek
director-key-live = Aras
director-key-set = Set
director-key-set-tip = Berikan nilai kerangka kunci ini sendiri.
director-key-unset = Kembali ke nilai trek
director-key-unset-live = Kembali ke langit hidup
director-title = Pengarah
director-tab-track = Trek
director-tab-camera = Kamera
director-tab-look = Lihat
director-tab-output = Output
director-tab-library = Pustaka
director-tab-filters = Penapis
director-filters-note = Penapis dan LUT tetingkap Foto: satu timbunan untuk foto dan filem. Trek dirakam dan dirender dengannya.
director-freeze-world-tip = Seperti dalam tetingkap Foto: avatar, animasi dan segala yang bergerak tetap diam, kamera tetap bebas. Trek dimainkan melalui dunia beku berputar di sekeliling saat diam.
director-thumb-missing-tip = Tiada gambar bagi paparan ini lagi: ia diambil bila bingkai kunci diletakkan atau dikemaskini, pada Pergi ke, dan bila trek dimainkan melaluinya.
director-camera = Kamera
director-lens = Sudut paparan
director-roll = Senarai
director-roll-reset = Jajarkan paparan
director-free-camera = Kamera bebas
director-free-camera-tip = Kamera meninggalkan avatar: terbangkannya dengan kekunci pergerakan, lihat sekeliling dengan butang tetikus kanan.
director-free-speed = Kelajuan
director-keyframe-title = Bingkai Kunci
director-keyframe-none = Pilih bingkai kunci pada garis masa atau di dunia untuk mengeditnya.
director-keyframe = Bingkai Kunci { $number }
director-keyframe-at = Bingkai Kunci { $number } pada { $time }
director-key-time = Masa
director-go-to = Pergi ke
director-go-to-tip = Pindah kamera ke bingkai kunci ini, untuk melihat melaluinya atau selaraskan ia. Klik dua kali pada bingkai kekunci melakukan yang sama.
director-update = Kemas kini
director-update-tip = Gantikan bingkai kunci ini dengan paparan semasa.
director-delete = Hapuskan
director-path = Laluan
director-curve-smooth = Lengkung
director-curve-linear = Garis lurus
director-even-speed = Kelajuan
director-even-speed-tip = Alihkan kerangka kunci pada garis masa supaya kamera menyimpan kelajuan yang sama sepanjang keseluruhan laluan. Tempoh tidak berubah.
director-ease = Mula dan akhir yang lancar
director-ease-tip = Kamera meninggalkan keyframe pertama dari rehat dan datang untuk berehat pada yang terakhir.
director-show-path = Papar laluan di dunia
director-summary =
    { $count ->
        [one] { $count } keyframe
       *[other] { $count } keyframes
    } · { $seconds } s · { $meters } m
director-playback = Main semula
director-start-delay = Lengah mula
director-start-delay-tip = Paparan pertama ditahan selama ini sebelum kamera pergi, dengan antaramuka sudah tersembunyi: masa untuk mula merakam.
director-hide-huds = Sembunyikan HUD semasa bermain
director-loop = Gulung
director-clear = Kosongkan trek
director-clear-tip = Kosongkan trek: setiap keyframe pergi (diminta dahulu; Nyahcara membawa mereka kembali)
director-clear-confirm = Kosongkan laluan?
director-clear-confirm-text =
    { $count ->
        [one] Bingkai kuncinya telah dipadam. Nyahcara (Ctrl+Z) membawanya kembali.
