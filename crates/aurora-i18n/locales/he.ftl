director-title-full = לשיר יש 16 כותרים לכל היותר.
director-title-text-hint = שורה אחת או יותר
director-title-text-tip = הטקסט של הכותרת: שורה חדשה עבור כל שורה.
director-title-when = מתי
director-title-when-start = התחל
director-title-when-end = סוף
director-title-when-range = פעמים
director-title-at-start = התחל, { $seconds } s
director-title-at-end = סוף, { $seconds } s
director-title-range = { $from } עם זה { $to } s
director-title-length = אורך
