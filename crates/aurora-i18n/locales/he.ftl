director-even-speed = גם מהירות
director-even-speed-tip = זוז את פרקי הזמן על קו הזמן כך שהמצלמה תשמור על אותה מהירות לאורך כל המסלול. משך הזמן לא משתנה.
director-ease = התחלה וסוף חלקים
director-ease-tip = המצלמה עוזבת את קובץ המפתח הראשון ממנו היא נחה ומגיעה לנחות על הקובץ האחרון.
director-show-path = להראות את הדרך בעולם
director-summary =
    { $count ->
        [one] { $count } מסגרת מפתח
       *[other] { $count } תמונות מפתח
    } · { $seconds } s · { $meters } m
director-playback = ניגון
director-start-delay = עיכוב התחלה
director-start-delay-tip = התצוגה הראשונה נעשית זמן רב לפני שהמצלמה עוזבת, עם הממשק כבר חבוי: הזמן להתחיל להקליט.
director-hide-huds = הסתר את ה- HUD בזמן משחק
director-loop = לולאה
director-clear = פנו את המסלול.
director-clear-tip = ניקוי הנתיב: כל פרק מפתח הולך (שואלים קודם; ביטול מחזיר אותם)
director-clear-confirm = לנקות את המסלול?
director-clear-confirm-text =
    { $count ->
        [one] מסגרת המפתח שלו נמחקה. ביטול (Ctrl+Z) מחזיר אותה.
       *[other] זה... { $count } תמונות מפתח נמחקו. בטל (Ctrl+Z) מחזיר אותן.
    }
director-clear-action = נקי.
director-environment = סביבה
director-rewind = בחזרה להתחלה.
director-play = נגן את השיר. הממשק חבוי; Escape עוצר.
director-play-needs-keys = הוסף לפחות שתי תמונות מפתח כדי לנגן את השיר.
director-restricted = RLVa מגביל את המצלמה: השיר לא יכול לנגן והתצוגה לא יכולה להיות נעול.
director-add-keyframe = פרק מפתח
director-add-keyframe-tip = הוסף פרק מפתח עם התצוגה הנוכחית: היכן המצלמה נמצאת, איפה היא נראית וזווית הראייה שלה.
director-track-full = המסלול מלא.
director-starts-in =
    { $seconds ->
        [one] מתחיל ב { $seconds } שנייה
       *[other] מתחיל ב { $seconds } שניות
    }
director-stop-hint = Esc כדי לעצור
director-key-time-tip = כשהמצלמה נמצאת על פרק המפתח הזה, רק הפרק הזה זז בין שני השכנים שלו.
director-span-time = משך המקטע
director-span-time-tip = הזמן שהמצלמה לוקחת מהפרק המפתח הקודם לזה, הפרקים המפתחים אחריו נעים איתו, כך שהחלקים האחרים שומרים על הקצב שלהם.
director-span-speed = מהירות המקטע
director-span-speed-tip = המהירות הממוצעת של המצלמה מהפרק הקודם לזה. מהירות חדשה משנה את אורך החלק; הפרקים הבאים אחריו נעים איתו.
director-span-speed-still = המצלמה לא נעה על המקטע הזה: היא רק מסתובבת או עושה זום. הגדירו את משך הזמן שלה במקום.
director-duration = משך זמן סך הכל
director-duration-tip = מרחיב או מקצר את כל המקטעים באופן דומה: כל השביל איטי יותר או מהיר יותר.
director-keyframe-hint = גרור: הזז אותו בזמן. Shift + גרור : גם תמונות המפתח לאחר שהוא זז. לחיצה כפולה: לך אליו.
director-keyframe-pick-hint = Ctrl + לחיצה: הוסף אותו לבחירה או הסירו אותו. Shift + לחצה: בחר כל פרספקטיבה עד אליה.
director-key-group = { $count } תמונות מפתח נבחר: הגדרה שונה כאן הולך לכל אחד מהם (המקום, הכתובת והזמן שלהם נשאר שלהם).
director-key-rest = עצור על פרק המפתח הזה
director-key-rest-tip = המצלמה מאטת לעצור על קובץ המפתח הזה ועוזבת אותו בעדינות, במקום לעבור במהירות רק עם העקומה.
director-key-lock = נעול את המבט על המטרה.
director-key-lock-tip = פריסת מפתח זו נעולה בעצמה, ללא קשר לפריסות המפתח האחרות ולמצלמה החיה. פעילה, היא מסתכלת על היעד שלה כשהשיר מנגן (המטרה של הנעילה, נלקחת כאשר היא מופעלת); כבויה, במקום שבו המצלמה שלה הונחה.
director-key-aim = מסתכל על
director-key-aim-tip = על מה התצוגה מסתכלת כאשר השיר מנגן את פרק המפתח הזה. בין שני פרקי מפתח, היא מסתובבת בצורה חלקה ממה שהיא רואה לזה שאחריה.
director-key-aim-lock-on = המטרה של המנעול: { $target }
director-key-aim-lock-off = איפה המצלמה שלו מונח (זה עוקב אחרי המנעול, אשר כבה)
director-key-aim-free = היכן שהמצלמה שלו מונחת
director-aim-joint = { $target } · { $joint }
director-key-aim-take = השתמש במטרה של המנעול.
director-key-aim-take-tip = פרק מפתח זה מסתכל על המטרה שנבחרה תחת נעילה, כפי שהיא עכשיו. הוא שומר אותה כאשר נעילת המטרות משתנה או כשהיא מושבתת.
director-hide-pointer = מסתיר את הסמן של העכבר בזמן משחק
director-lock = נעול
director-lock-on = נעול את המבט על המטרה.
director-lock-on-tip = המטרה נשארת במרכז התצוגה בכל מקום בו תזיז את המצלמה, ללא צורך בפריסת מפתח. פריסה מפתח שהוספה כשהתצוגה נעולת ננעלת על המטרות הללו, גם אם תבחרי אחרת לאחר מכן; כל פריסה שומרת על המנעול שלה, המוגדרת בשורה שלה בלשונית מסלול.
director-lock-target = מטרה
director-lock-own = האווטאר שלי.
director-lock-avatar = עוד אווטאר.
director-lock-object = אובייקט
director-lock-pick-own = האווטאר שלי.
director-lock-pick-focus = מיקוד המצלמה
director-lock-pick-focus-tip = Alt + לחץ על אווטאר או עצמה כדי למקד את המצלמה עליה, ואז לחץ כפתור זה: התצוגה ננעלת על האווטאר (גם דרך מה שהוא לובש) או על העצמה.
director-lock-joint = חלקי גוף
director-lock-smoothing = מלחמה
director-lock-smoothing-tip = כמה זמן לוקח לנקודת המבט לתפוס את המטרה. ב-0 היא עוקבת אחרי כל תנועה, כולל כל צעד של ריקוד; גבוה יותר, היא עוקפת כמו מפעיל מצלמה.
director-lock-lost = המטרה אינה בראייה: היכן שהיא נראית, המבט הוא חופשי.
director-joint-head = ראש.
director-joint-neck = צוואר.
director-joint-chest = חזה.
director-joint-pelvis = אגן.
director-joint-left-hand = יד שמאל.
director-joint-right-hand = יד ימין.
director-picture = תמונה
director-format = פורמט
director-format-tip = הפרופורציות של הסרט. בזמן שאתה ערוך, המסגרת מוגדרת ומה שמחוצה לה מטושטש; בזמן שהשיר נשמע, קוים שחורים מסתירים אותו.
director-format-window = חלון
director-thirds = חוק השלישיות.
director-delete-tip = מחק את מסגרות המפתח הנבחרות (מחק)
director-undo = בטל (Ctrl+Z)
director-redo = חזרה (Ctrl+Y)
director-isolate-empty = רקע ריק
director-isolate-empty-tip = אין שמיים, אדמה, מים או עננים מסביב למה שמופיע: רקע פשוט כדי לחתוך את הנושא מהסרט.
director-key-color = צבע הרקע
director-key-color-tip = ממלא את הרקע הריק בצבע יחיד, ירוק תחילה: מסך ירוק, כדי להדגיש אותו בעת עריכת הסרט. בחר צבע שלא לובש הנושא.
director-record = הקלטת
director-record-looking = מחפש ffmpeg...
director-record-missing = ffmpeg לא מותקנת: זו התוכנה החופשית שמקודדת את הסרט.
director-record-missing-hint = התקן אותו (בטרמינל Windows: winget install ffmpeg), ואז לחץ על "Look again"; או בחר את הקובץ שלו אם כבר יש לך אותו.
director-record-site = דף הורדה
director-record-choose = בחר ffmpeg...
director-record-again = תסתכל שוב.
director-record-found = מקודד: { $name }
director-record-format = פורמט
director-record-format-mp4 = MP4 (H.264): נשמע בכל מקום
director-record-format-prores = MOV (ProRes 422): לשם עריכה
director-record-format-prores-alpha = MOV (ProRes 4443): רקע שקוף
director-record-format-webm = WebMName
director-record-format-lossless = MKV (FFV1): ללא אובדן
director-record-fps = תמונות לשנייה
director-record-quality = איכות
director-record-quality-light = אור.
director-record-quality-good = טוב.
director-record-quality-best = הכי טוב.
director-record-alpha-tip = עם "מבודד" על רקע ריק, מה שנשאר ריק נשאר שקוף בסרט.
director-record-no-sound = לסרט אין צליל.
director-record-start = הקלטת
director-record-stop = עצור את ההקלטה.
director-record-tip = עם שביל: מנגן אותו ומצלם אותו, עד לסיום. ללא שביל, מצלם את התצוגה עד ללחיצת כפתור נוספת. הסרט הוא תצוגה תלת מימדית בלבד, ללא ממשק.
director-record-unavailable = ffmpeg נדרש להקלטה: ראו הקלטת בחלון הבמאי.
director-record-recording = הקלטת { $time }
director-record-finishing = מסיים את הקובץ...
director-record-saved = סרט שמור: { $name }
director-record-failed = הסרט לא ניתן לכתוב: { $why }
director-record-reveal = הראה בתיקייה שלו
director-record-no-encoder = ffmpeg לא יכול לכתוב בפורמט הזה: בחר פורמט אחר.
director-shake = מצלמה ידנית
director-shake-tip = בזמן שהשיר מנגן, המצלמה נשטפת ומסתובבת קצת מסביב למסלול שלה, כמו מישהו שמחזיק ביד. 0: מצלמה יציבה.
director-dof = עומק שדה
director-dof-tip = עדשה של הבמאי עצמו: חדה על המטרה של המנעול (או במרחק קבוע), מטושטשת לפני ומעבר.
director-dof-aperture = פתח
director-dof-focus = מרחק מיקוד
director-dof-on-target = ממוקד במטרה של המנעול.
director-tracks = שירים נשמרים
director-track-name = שם השיר הזה
director-track-save = שמור
director-track-load = טען את השיר הזה (השיר שנערך הוחלף; Ctrl+Z מחזיר אותו)
director-track-none = עדיין לא נשמר שום שביל.
director-track-saved = שמור: { $name }
director-track-loaded = טעון: { $name }
director-track-failed = לא ניתן להשתמש בקובץ השיר: { $why }
director-track-bad-name = תן לשיר שם קודם.
# Director — shots
director-shots = יריות.
director-shot = ירייה.
director-shot-orbit = מסלול
director-shot-orbit-tip = המצלמה עוברת מסביב למרכז, מסתכלת על זה, מהמקום בו הוא נמצא עכשיו.
director-shot-dolly-zoom = דולי זום
director-shot-dolly-zoom-tip = המצלמה מתקרבת יותר למרכז (או נסוגת) בעוד שהעדשה מתרחבת (או מצטמצמת): הנושא שומר על גודלו, הרקע מתפשט או נסגר. אפקט העצירות.
director-shot-crane = תורן למעלה
director-shot-crane-tip = המצלמה עולה ישר למעלה, עדיין מסתכלת על המרכז.
director-shot-truck = מעקב
director-shot-truck-tip = המצלמה זורקת את עצמה לצדדים, מסתובבת כפי שהיא.
director-shot-push-in = דחוף פנימה.
director-shot-push-in-tip = המצלמה נעה קדימה לאורך הנוף, לעולם לא מעבר למרכז.
director-shot-pull-out = תתרחק.
director-shot-pull-out-tip = המצלמה נעה אחורה לאורך המבט.
director-shot-fly-over = תעופה מעל
director-shot-fly-over-tip = המצלמה עוברת מעל המרכז ועל לצד השני שלה, מסתכלת קדימה ומטה.
director-shot-arc = קשת
director-shot-arc-tip = כמה רחוק סביב המרכז המצלמה הולכת: 360 מעלות זה סיבוב אחד.
director-shot-duration = משך
director-shot-duration-tip = שניות הירי נמשך.
director-shot-distance = מרחק
director-shot-distance-tip = המרחק שהמצלמה עוברת.
director-shot-rise = קום.
director-shot-rise-tip = מטרים המצלמה עולה.
director-shot-over = גובה מעל
director-shot-over-tip = מטרים מעל המרכז בו המצלמה עוברת (מעל גובה המצלמה עצמה כאשר היא גבוהה יותר).
director-shot-direction = כיוון
director-shot-closer = קרוב יותר.
director-shot-farther = רחוק יותר.
director-shot-left = שמאלה
director-shot-right = נכון.
director-shot-ccw = נגד כיוון השעון
director-shot-cw = בכיוון השעון
director-shot-around = מרכז
director-shot-around-target = המטרה של המנעול
director-shot-around-focus = המיקוד של המצלמה
director-shot-around-tip = מה הצילום עובר סביב או מסתכל על: המטרה של המנעול בזמן שהמנעול פועל והוא בראייה, אחרת המיקוד של המצלמה (לפני מצלמה חופשית או flycam, בעומק של מרחק השדה).
director-shot-add = אחרי המסלול
director-shot-replace = החלף את השיר
director-shot-make = תירה.
director-shot-make-tip = משאיר את תמונות המפתח של הצילום מהתצוגה הנוכחית, אחרי תמונות מפתח אחרונות של הסרט (המצלמה עוברת ממנה לצילום) או במקום הסרט. הן תמונות כמו כל תמונות אחרות; Ctrl+Z לוקח את הצילום כולו בחזרה.
director-shot-no-room = אין מקום לצילום הזה מכאן: המצלמה נמצאת במרכזה, או שהעדשה כבר נמצאת בגבולותיה.
director-shot-full = בשיר אין מקום ליותר מזה של תמונות מפתח.
director-shot-too-long = המסלול נמשך יותר משעה.
director-shot-made = ירייה הונחה: { $count } תמונות מפתח, { $seconds } s.play מנגן את זה מהפריים הראשון שלו.
director-shot-more = אפשרויות נוספות
director-shot-radius = רדיוס
director-shot-radius-tip = המרחק של המסלול מהמרכז, מטר חי: המצלמה עצמה, כך שהמסלול מתחיל היכן שהוא.
director-shot-height = גובה
director-shot-height-tip = גובה המסלול מעל המרכז, מטר.
director-shot-live = רמה: { $value } m
director-shot-set = הגדרת ערך משלו
director-shot-reset-live = בחזרה לערך החי.
director-shot-climb = טיפוס.
director-shot-climb-tip = מטרים שהמצלמה עולה (או יורדת) מההתחלה של המסלול עד לסיום שלו: ספירלה.
director-shot-travel = נסיעה עם המטרה
director-shot-travel-tip = תמונות המפתח של הצילום נעות עם המטרה של המנעול: מסלול סביב רקדן שמלך נשאר סביבם.
director-shot-travel-off = רק עם המנעול על והמטרה שלו בטווח הראייה.
director-key-ease = מקל.
director-key-ease-tip = איך המצלמה מתחילה ועוצרת בדרכה לפרמטר המפתח הזה מהקודם. הנתיב והזמן שלו נשארים; הקצה שלא נרגע שומר על המהירות של העקומה.
director-ease-linear = לינארי
director-ease-in = תיכנסו בעדינות.
director-ease-out = תירגע.
director-ease-in-out = קל להיכנס ולצאת.
director-key-dolly-zoom = דולי זום
director-key-dolly-zoom-tip = בדרך לפרספקטיבה זו, העדשה משתנה עם המרחק כך שנושא קדימה שומר על גודלו: לתת את שני פרספקטיבות העדשות שלהם, המצלמה נעה ישר אל הנושא או רחוק ממנו.
director-key-travel = נסיעה עם המטרה שלו
director-key-travel-tip = פרק המפתח הזה שומר על מיקומו ליד המטרה שלו כשהמטרה נעה (בכיוונים של העולם), במקום להישאר במקום בו הוא הוצב. עדכון מסדר אותו שוב מהתצוגה הנוכחית.
director-key-travel-none = פרק המפתח הזה לא מסתכל על מטרה: תן לו את המטרה של המנעול קודם.
# Director — montage and tracks
director-zoom-in-tip = זום על קו הזמן (Ctrl + גלגל עכבר)
director-zoom-out-tip = הקטנת זום (Ctrl + גלגל עכבר). לא זמין: כל השביל כבר מופיע.
director-zoom-fit-tip = הראה את כל השביל. לא זמין: הוא כבר מופיע.
director-thumbnail-tip = התצוגה של מסגרת המפתח הזו. לחץ: בחר אותה. לחיצה כפולה: לך לשם (מסגרת מפתח ללא תמונה מקבלת אחת שם).
director-more-options = אפשרויות נוספות
director-library-import = ייבוא...
director-library-import-tip = הוספת רצועה או מונטאז' מקובץ ששיתף מישהו, לאלה שנשמרו (שום דבר לא הוחלף).
director-library-export = ייצוא...
director-library-export-tip = שמור את השיר שנערך לקובץ של בחירתך, כדי לשתף אותו.
director-library-export-empty = לשיר אין עדיין פרק מפתח.
director-library-export-name = שיר
director-library-busy = חכה לקריאה או כתיבה של הקובץ.
director-library-save-tip = שמור את הרצועה הנערכת בשם זה.
director-library-thumb-tip = המבט הראשון שלו, כאשר תמונה של זה נלקחה בשיחה זו.
director-library-length = { $time } s
director-library-rename-tip = שינוי שם השיר
director-library-rename-confirm = שינוי שם
director-library-renamed = שינוי שם: { $name }
director-library-name-taken = שיר שמור כבר נקרא "% 1"{ $name }”.
director-library-delete-tip = מחק את השיר הזה (שואלים קודם)
director-library-delete-confirm = למחוק את השיר?
director-library-delete-text = “{ $name }"" נמחקה מהמחשב הזה. לא ניתן לבטל את הפעולות הללו. המונטאז'ים שמנגנים אותה מראים שהיא חסרה.
director-library-delete = מחק
director-library-deleted = מחק: { $name }
director-library-imported = ייבוא: { $name }
director-library-imported-name = ייבוא
director-library-exported = ייצא: { $name }
director-library-too-large = הקובץ הזה גדול מדי מכדי להיות שיר או מונטאז'.
director-library-unreadable = הקובץ הזה הוא לא רצועה ולא מונטאז', או שהוא פגום.
director-library-version = הקובץ הזה נוצר על ידי מראה חדש יותר (גרסה { $version }): עדכן את אורורה כדי לפתוח אותה.
director-montage = תיקון
director-montage-empty = עדיין אין צילום: הוסף שירים נשמרים כדי לנגן אותם אחד אחרי השני.
director-montage-shot-missing = חסר, נדחק
director-montage-shot-short = פרק מפתח אחד, נדחה
director-montage-shot-unusable = בלתי ניתן לשימוש, נדחה
director-montage-skipped-tip = צילום זה נדחה: השביל שלו חסר, לא ניתן לקרוא אותו, או שיש בו פחות משתי תמונות מפתח.
director-montage-up-tip = תזיז את הצילום מוקדם יותר.
director-montage-down-tip = תזיז את הצילום הזה מאוחר יותר.
director-montage-remove-tip = הסר את הצילום הזה (השביל שלו נשאר נשמר)
director-montage-add = הוסף
director-montage-add-tip = הוסף את השיר הנשמר הזה בסוף המונטאז'
director-montage-add-none = שמור רצועה קודם: המונטאז' מנגן את הרצועות שנשמרו.
director-montage-total =
    { $shots ->
        [one] סך הכל { $time } s, { $shots } ירייה
       *[other] סך הכל { $time } s, { $shots } יריות.
    }
director-montage-play = נגן מונטאז'
director-montage-play-tip = מנגן את הסרטונים אחד אחרי השני, עם חתך בין כל אחד. לחצן Esc עוצר; השיר שעובר עריכה חוזר.
director-montage-film = סרטון הקלטה
director-montage-film-tip = הקלט את כל המונטאז' כסרט אחד, מחתיכה לחתיכה.
director-montage-nothing = אף צילום של המונטאז' לא יכול להישמע: כל אחד צריך שביל שמור של לפחות שני פרקי מפתח.
director-montage-restricted = המצלמה מוגבלת (RLVa או אוזניות): המונטאז' לא יכול לנגן.
director-montage-name = שם המונטאז' הזה
director-montage-bad-name = תן למונטג' שם קודם.
director-montage-save-tip = שמור את המונטאז' תחת השם הזה (הוא שומר על שמות הרצועות שלו, לא על עותקים).
director-montage-none = אין מונטאז' שמור עדיין.
director-montage-load-tip = טען את המונטאז' הזה (המונטאז 'שמורכב מוחלף)
director-montage-delete-tip = מחק את המונטאז' הזה (בקש קודם; השירים שלו נשארים)
director-montage-delete-confirm = למחוק את המונטאז'?
director-montage-delete-text = “{ $name }” נמחקה מהמחשב הזה. לא ניתן לבטל את הפעולות הללו. עקבותיה נשארים נשמרים.
director-montage-export = ייצוא סרטון
director-montage-export-tip = שמור את המונטאז' והשירים שהוא מנגן לקובץ אחד, כדי לשתף אותו.
director-montage-clear = נקי.
director-montage-clear-tip = הסר כל צילום מהמונטאז' (השירים נשארים נשמרים)
director-ffmpeg-title = ההקלטה דורשת ffmpeg
director-ffmpeg-step-download = ניתן להוריד את ffmpeg מהאתר שלו (דף ההורדה).
director-ffmpeg-step-pack = הורדה של ffmpeg (Download ffmpe g), או להשיג אותו מהאתר שלו.
director-ffmpeg-step-install-windows = התקן אותו: בטרמינל Windows, winget install ffmpeg; או לפרק אותו ולהוסיף את תיקיית bin שלו ל- PATH.
director-ffmpeg-step-install-macos = התקן אותו: בטרמינל, brew install ffmpeg.
director-ffmpeg-step-install-linux = התקן אותו עם חבילות המערכת שלך (לדוגמה: sudo apt install ffmpeg).
director-ffmpeg-step-look = לחץ על "חפש שוב": אין צורך בהפעלה מחדש. או בחר את הקובץ שלו עם "בחרו ffmpeg...".
director-ffmpeg-site-tip = פתח את דף ההורדה של ffmpeg בדפדפן שלך
director-ffmpeg-choose-tip = בחר את התוכנית ffmpeg (ffmpeg. exe ב- Windows) אם היא לא נמצאת בשביל PATH
director-ffmpeg-again-tip = חפש שוב אחר ffmpeg, ב- PATH כפי שהוא עכשיו
director-ffmpeg-still-missing =
    { $count ->
        [one] עדיין לא נמצא. אם הרגע התקנת אותו, בחר את הקובץ שלו עם "בחרו ffmpeg...".
       *[other] עדיין לא נמצא.{ $count } אם הרגע התקנת אותו, בחר את הקובץ שלו עם "בחרו ffmpeg...".
    }
director-ffmpeg-pack = הורדת ffmpeg
director-ffmpeg-pack-tip = להוריד את ffmpeg שפרויקט אורורה מפרסם (הגודל שלו מופיע קודם)
director-ffmpeg-pack-confirm = הורדת ffmpeg?
director-ffmpeg-pack-confirm-text = ה- ffmpeg של פרויקט אורורה הוא { $size } MB. זה נבדק ברגע שהורדה, אז נשמר ליד תוספי מדיה.
director-ffmpeg-pack-download = הורדה
director-ffmpeg-pack-progress = { $done } של { $total } MB
director-ffmpeg-pack-preparing = בדיקה והתקנה...
director-ffmpeg-pack-failed = ההורדה נכשלה או שהקובץ לא היה זה שצפוי: שום דבר לא הותקן.
# Director — render, fades and titles
director-output-live = רמה
director-output-render = ריצוף
director-output-more = אפשרויות נוספות
director-output-format-tip = הפורמט שבו נכתב הסרט. פורמט שאינו ניתן לכתיבה על ידי ffmpeg מופיע באפור.
director-output-fps-tip = פרקים לשנייה של הסרט. ב-120, סרט חי צריך שהצופה יצייר 121 פרקים בשניה, או שהפרקים חוזרים על עצמם; ברנדור יש כל פרק.
director-output-quality-tip = קובץ קל יותר, או תמונה נקייה יותר.
director-sound = קול
director-sound-tip = הסרט נושא את הצליל של הצופה: הצלילים של העולם, המוזיקה והמדיה, בנפחים שאתה שומע אותם.
director-sound-no-encoder = ל- ffmpeg הזה אין מקודד אודיו עבור פורמט זה: הסרט שקט.
director-sound-off = תדליק את הצליל קודם.
director-sound-ui = צלילים של ממשק
director-sound-ui-tip = צלילי הממשק (קליקים, אזהרות) גם בסרט.
director-sound-voice = צ' אט קולי (אנשים אחרים)
director-sound-voice-tip = הקלט את הקולות של האנשים סביבך, שאל אותם קודם.
director-sound-voice-on = צ'אט קולי מוקלט: הקולות של אנשים אחרים נמצאים בסרט.
director-render-start = ריצוף
director-render-tip = סרט את השביל לא בזמן אמת: כל פרק מוצב שלם בגודל שנבחר, אף אחד לא חוזר או נופל. האנימציות של הצופה עוקבות אחר שעון הסרט; מה שהשרת מזיז שומר על הזמן שלו.
director-render-needs-track = רינדור זקוק לשביל של לפחות שתי תמונות מפתח, ומצלמה RLVa לא מחזיקה.
director-render-png = תמונות PNG (לא ffmpeg)
director-render-png-quality = תמונות PNG הן ללא אובדן: אין איכות לבחור.
director-render-size = גודל
director-render-size-tip = הגודל של הסרט, לא משנה מה החלון: פורמט התמונה של המסלול גדול ככל שהוא מתאים.
director-render-window = חלון
director-render-no-sound = לרנדור אין צליל: העולם שלו לא רץ בזמן אמת.
director-render-progress = מסגרת { $done } של { $count }
director-render-progress-left = מסגרת { $done } של { $count }, { $left } שמאל
director-render-cancel = עצור את הריצוף
director-render-cancel-tip = Stops it (Escape too): המסגרות שכבר נכתבו נשמרו.
director-render-cancelled = ההצגה נעצרה: המסגרות שנכתבו עד כה נשמרו.
director-render-interrupted = ההצגה נעצרה (החלון נסגר, טלפורט או RLVa): הצילומים שנכתבו עד כה נשמרים.
director-render-draw-failed = לא ניתן היה לצייר מסגרת (זיכרון וידאו?): נסה גודל קטן יותר.
director-render-write-failed = לא ניתן היה לכתוב את המסגרות (המקודד או הדיסק).
director-fades = הכחדה
director-fade-in = נעלמת
