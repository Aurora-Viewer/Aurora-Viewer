ui-group-admin-ban-ability-given = אתה עומד להוסיף את היכולת '{ $action }'לתפקיד'{ $role }"היכולות"{ $eject }'ו'{ $remove }'מתקבלים עם זה.
ui-group-admin-ban-ability-taken = אתה עומד להסיר את היכולת '{ $action }'מהתפקיד'{ $role }"היכולות"{ $eject }'ו'{ $remove }'זה הביא להישאר.
ui-group-admin-insignia = סמלים
ui-group-admin-insignia-change = תשנה את הסמל.
ui-group-admin-settings = הגדרות
ui-group-admin-show-in-search = הראה בחיפוש
ui-group-admin-moderate = תוכן בינוני
ui-group-admin-fee = תשלום הרשמה
ui-group-admin-pick-ability = בחר יכולת כדי לראות למי יש אותה.
ui-group-admin-roles-with = תפקידים עם היכולת הזו
ui-group-admin-members-with =
    { $count ->
        [one] חבר אחד עם היכולת הזו
       *[other] { $count } חברים עם היכולת הזו
    }
ui-group-admin-nobody = לאף תפקיד אין את היכולת הזו.
ui-group-admin-bans-count = { $count } נאסר על { $max } לכל היותר
ui-group-admin-ban-residents = תושבי באן.
ui-group-admin-no-bans = אף אחד לא נאסר מהקבוצה הזאת.
ui-group-admin-unban = הסר את ההגבלה
ui-group-admin-already-banned = כבר נאסר: { $names }
ui-group-admin-cannot-ban-yourself = אתה לא יכול להרחיק את עצמך.
ui-group-admin-ban-limit = לא נאסר, רשימת האיסור מלאה: { $names }
group-abilities-membership = חברות
group-abilities-membership-help = יכולות אלה כוללות כוחות להוסיף ולהסיר חברים בקבוצה, ולאפשר לחברים חדשים להצטרף ללא הזמנה.
group-ability-member-invite = הזמין אנשים לקבוצה זו
group-ability-member-invite-help = הזמין אנשים לקבוצה זו באמצעות לחצן 'הזמנה' בחלק חברים ותפקידים > לוח החברים.
group-ability-member-eject = דחף חברים שייכים לתפקיד 'כל אחד' מהקבוצה הזו
group-ability-member-eject-help = זרוק חברים מהקבוצה הזו בעזרת הכפתור 'זרוק' בקטע חברים ותפקידים > כרטיסייה חברים. בעל יכול לזרוק כל אחד חוץ מבעל אחר. אם אינך בעל, ניתן לזרוע חבר מקבוצה אם, ורק אם, הוא נמצא רק בתפקידו של כולם, ולא בתפקודים אחרים. כדי להסיר חברים מתפקדים, עליך להיות בעל היכולת 'הסרה של חברים מתפקיד'.
group-ability-allow-ban = ניהול רשימת חסמים
group-ability-allow-ban-help = מאפשר לחבר הקבוצה להגביל / לפתור את הגבלת התושבים מהקבוצה הזו.
group-ability-member-options = תעבור ל'הרשמה פתוחה' ותשנה את 'תשלום ההרשמה'
group-ability-member-options-help = הקש על 'הרשמה פתוחה' כדי לאפשר לחברים חדשים להצטרף ללא הזמנה, ושנה את 'תשלום ההרשמה' בחלק הכללי.
group-abilities-roles = תפקידים
group-abilities-roles-help = יכולות אלה כוללות כוחות להוסיף, להוריד ולשנות תפקידים בקבוצה, להוסיפם ולהסיר חברים בתפקיד, ולהקצות יכולות לתפקיד.
group-ability-role-create = יצירת תפקידים חדשים
group-ability-role-create-help = יצור תפקידים חדשים בחלק חברים ותפקידיים > תפקודים.
group-ability-role-delete = מחיקת תפקידים
group-ability-role-delete-help = מחיקת תפקידים בחלק חברים ותפקידיים > כרטיסייה תפקודים.
group-ability-role-properties = שינוי שמות תפקידים, תארים, תיאורים, ואם חברי התפקידים נחשפים לציבור
group-ability-role-properties-help = שינוי שמות תפקידים, תאריכים, תיאור, ואם חברי התפקיד נחשפים לציבור. זה נעשה בחלק התחתון של החלק חברים ותפקודים > תפקודים לאחר בחירת תפקד.
group-ability-role-assign-member-limited = הקצאת חברים לתפקידים של המקביל
group-ability-role-assign-member-limited-help = הקצאת חברים לתפקודים ברשימת התפקידים המוקצים (החלק חברים ותפקידים > לוח החברים). חבר עם היכולת הזו יכול להוסיף חברים רק לתפקידי שהממונה כבר נמצא בהם.
group-ability-role-assign-member = הקצאת חברים לכל תפקיד
group-ability-role-assign-member-help = הקצאת חברים לכל תפקיד ברשימת התפקידים המוקצים (החלק חברים ותפקידים > לוח החברים). * אזהרה* כל חבר בתפקיד עם היכולת הזו יכול להקצות את עצמו - ואת כל חבר אחר שאיננו בעל - לתפקיד שיש לו יותר כוחות ממה שיש לו כיום, מה שעשוי להעלות אותו לכמעט כוח של בעל. וודאו שאתם יודעים מה אתם עושים לפני שהקצתם את היכולת הזאת.
group-ability-role-remove-member = הסר חברים מתפקידים
group-ability-role-remove-member-help = הסר חברים מתפקידים ברשימת התפקידים המוקצים (החלק חברים ותפקידיים > לוח החברים). לא ניתן להסיר את הבעלים.
group-ability-role-change-actions = הקצאת והסרה של יכולות בתפקודים
group-ability-role-change-actions-help = הקצאת והסרה של יכולות לכל תפקיד ברשימת האפשרויות המותרות (החלק חברים ותפקידים > לוח התפקידים). * אזהרה* כל חבר בתפקיד עם היכולת הזו יכול להקצות לעצמו - ולכל חבר אחר שאיננו בעל - את כל היכולות, באופן פוטנציאלי להעלות את עצמו לכמעט כוח של בעל. וודאו שאתם יודעים מה אתם עושים לפני שהקצתם את היכולת הזאת.
group-abilities-group-identity = זהות הקבוצה
group-abilities-group-identity-help = יכולות אלו כוללות כוחות לשנות את הזהות של הקבוצה, כמו שינוי ראות ציבורית, מסמך, וסמל.
group-ability-group-change-identity = שינוי מסמך, סימן ו'הצג בחיפוש'
group-ability-group-change-identity-help = שינוי כתב הזכויות, סימן ההיכר ו'הצג בחיפוש'. זה נעשה בחלק הכללי.
group-abilities-parcel-management = ניהול חבילות
group-abilities-parcel-management-help = יכולות אלה כוללות את האפשרות לחתום, לשנות ולמכור קרקע בנכסי הקרקע של הקבוצה הזו. כדי להגיע לחלון "על הקרקע", לחץ עם לחצן ימני על הקרקע ובחר "על קרקע", או לחץ על האייקון "i" בסרגל הנהיגה.
group-ability-land-deed = מסמך קרקע וקניית קרקע עבור הקבוצה
group-ability-land-deed-help = חתימה על קרקע ורכישת קרקע עבור הקבוצה. זה נעשה ב- About Land > General tab.
group-ability-land-release = נטוש את האדמה למושל לינדן.
group-ability-land-release-help = נטוש אדמה למושל לינדן. * אזהרה * כל חבר בתפקיד עם היכולת הזו יכול לטהר אדמה בבעלות הקבוצה ב- About Land > General tab, ולהחזיר אותה לבעלותו של לינדון ללא מכירה! תוודא שאתה יודע מה אתה עושה לפני שהקצת את היכולת הזאת.
group-ability-land-set-sale-info = הגדרת אדמה למכירה מידע
group-ability-land-set-sale-info-help = הגדרת מידע על קרקע למכירה. * אזהרה * כל חבר בתפקיד עם היכולת הזו יכול למכור קרקע בבעלות הקבוצה ב- About Land > General tab כפי שהוא רוצה! וודאו שאתם יודעים מה אתם עושים לפני שהקצתם את היכולת הזאת.
group-ability-land-divide-join = חלוקה והצטרפות לחבילות
group-ability-land-divide-join-help = חלוק ותחבר קרקעות. זה נעשה על ידי לחיצה ימנית על הקרקע, 'עריכה של קרקע', וגרירת העכבר על האדמה כדי לבצע בחירה. כדי לחלוק, בחר את מה שאתה רוצה לפצל ולחץ על 'חילוק'. כדי להצטרף, בצע בחירת שניים או יותר מקרקעות צמודות ולחצו על 'התאחד'.
group-abilities-parcel-identity = זהות החבילה
group-abilities-parcel-identity-help = יכולות אלו כוללות כוחות לשנות את שם החבילה והגדרות פרסום, ראות של תיקיית חיפוש, ואפשרויות נקודת נחיתה ונתיב TP.
group-ability-land-find-places = הפעל/ הפעל את 'הצג מקום בחיפוש' והגדרת קטגוריה
group-ability-land-find-places-help = הגדרת סוגיות בנושאים מרכזיים, וכן הגדרה של תחומי מחקר בהם מתמקדת התוכנית.
group-ability-land-change-identity = שינוי שם החבילה, תיאור והגדרות 'תוכן מודרני'
group-ability-land-change-identity-help = שינוי שם החבילה, תיאור והגדרות 'תוכן מודרני'. זה נעשה ב- About Land > Options tab.
group-ability-land-set-landing-point = הגדרת נקודת נחיתה והגדרת נתיב טלפורט
group-ability-land-set-landing-point-help = על חבילה שבבעלות קבוצה, חברים בתפקיד עם היכולת הזו יכולים להגדיר נקודת נחיתה כדי לפרט איפה טלפורטים פנימיים מגיעים, וגם להגיד את נתיב הטלפורט לשליטה נוספת. זה נעשה ב- About Land > Options tab.
group-abilities-parcel-settings = הגדרות חבילה
group-abilities-parcel-settings-help = יכולות אלו כוללות כוחות המשפיעים על אפשרויות החבילה, כמו "יצור עצמים", "עריכת שטח" והגדרות מוזיקה ומדיה.
group-ability-land-change-media = שינוי הגדרות מוזיקה ומדיהName
group-ability-land-change-media-help = שינוי הגדרות זרימת מוזיקה וסרטים ב- About Land > Media tab.
group-ability-land-edit = הפעל/ הפעל את 'עריכת שטח'
group-ability-land-edit-help = הפעל את 'עריכה שטח'. * אזהרה * על הקרקע > לוח אפשרויות > עריכת שטח מאפשרת לכל אחד לשנות את הצורה של הקרקע שלך, ולהניח ולהזיז צמח לימון. וודאו שאתם יודעים מה אתם עושים לפני שתציבו את היכולת הזו. עריכה של שטח מופעלת בנושא קרקע > כרטיסיית אפשרויות.
group-ability-land-options = הפעל/ השבת אפשרויות שונות בנושא ארץ > הגדרות אפשרויות
group-ability-land-options-help = ניתן להפעיל את האפשרויות "בטוח (ללא נזק)", "עוף" ולאפשר לתושבים אחרים: "לערוך שטח", "בנות", "ליצור סימני דרך" ו"להריץ תסריטים" על קרקע בבעלות הקבוצה ב-About Land > Options tab.
group-ability-land-change-environment = לשנות את ההגדרות של הסביבה ומחזור היום.
group-ability-land-change-environment-help = שינוי ההגדרות של הסביבה ומחזור היום מתוך כרטיסייה "על האדמה" > "סביבה".
group-abilities-parcel-powers = כוחות חבילה.
group-abilities-parcel-powers-help = יכולות אלו כוללות כוחות המאפשרים לחברים לעקוף מגבלות על חבילות בבעלות הקבוצה.
group-ability-land-allow-edit-land = תמיד הרשאי ל' עריכת שטח '
group-ability-land-allow-edit-land-help = חברים בתפקיד עם היכולת הזו יכולים לערוך את השטח על חפיסה בבעלות הקבוצה, אפילו אם היא כבושה ב About Land > Options tab.
group-ability-land-allow-fly = תמיד הרשאי ל'עוף'
group-ability-land-allow-fly-help = חברים בתפקיד עם היכולת הזו יכולים לטוס על חבילה בבעלות הקבוצה, אפילו אם היא כבושה ב About Land > Options tab.
group-ability-land-allow-create = תמיד אסור ליצור אובייקטים
group-ability-land-allow-create-help = חברים בתפקיד עם היכולת הזו יכולים ליצור עצמים על חפיסה בבעלות הקבוצה, אפילו אם היא כבושה ב About Land > Options tab.
group-ability-land-allow-direct-teleport = התעלם מנקודת נחיתה
group-ability-land-allow-direct-teleport-help = חברים בתפקיד עם היכולת הזו יכולים להעביר טלפורטציה ישירה לחבילה בבעלות הקבוצה, אפילו אם נקודת נחיתה מוגדרת ב About Land > Options tab.
group-ability-land-allow-set-home = הרשאת 'הגדרת בית לכאן' על אדמת קבוצה
group-ability-land-allow-set-home-help = חברים בתפקיד עם היכולת הזו יכולים להשתמש בתפריט עולם > Set Home to Here על חבילה המוגדרת לקבוצה זו.
group-ability-land-allow-host-event = הרשאת 'אירועי אירוח' על אדמת קבוצה
group-ability-land-allow-host-event-help = חברים בתפקיד עם יכולת זו יכולים לבחור חבילות בבעלות הקבוצה כוונוס כאשר הם מארחים אירוע.
group-abilities-parcel-access = גישה לחבילה
group-abilities-parcel-access-help = יכולות אלו כוללות כוחות לאפשר או להגביל גישה לחבילות בבעלות הקבוצה, כולל הקפאת וגירוש התושבים.
group-ability-land-manage-allowed = רשימות גישה
group-ability-land-manage-allowed-help = אתר האינטרנט הרשמי של מועדון הכדורגל אשדוד מועדוני כדורגל בארץ - אתר מועדונים.
group-ability-land-manage-banned = ניהול רשימת איסור חבילות
group-ability-land-manage-banned-help = אתר האינטרנט הרשמי של מועדון הכדורגל אשדוד מועדוני כדורגל באתר "הארץ"
group-ability-land-manage-passes = שינוי ההגדרות של חבילת 'מכירה עוברת אל'
group-ability-land-manage-passes-help = שינויים משמעותיים נוספים בתוכנית היו: הוספת אפשרות לעבור בין יישומים בתוך המערכת, באמצעות כפתור "העברה" (Transfer).
group-ability-land-admin = יוציאו את התושבים והקפיאו אותם על חבילות.
group-ability-land-admin-help = חברים בתפקיד עם היכולת הזו יכולים להתמודד עם תושב לא רצוי על חבילה בבעלות הקבוצה על ידי לחיצה ימנית עליהם, ולאחר מכן לבחור "לשחרר" או "להקפיא".
group-abilities-parcel-content = תוכן החבילה
group-abilities-parcel-content-help = יכולות אלה כוללות כוחות לאפשר לחברים להחזיר עצמים ולשים ולהזיז צמחים של לידן. זה מועיל לחברים לנקות זבל ולעשות נוף, אבל צריך גם להשתמש בו בזהירות, כי אין אפשרות לבטל החזרת עצמים.
group-ability-land-return-group-owned = החזרת אובייקטים בבעלות הקבוצה
group-ability-land-return-group-owned-help = החזרת אובייקטים על חפיסות בבעלות קבוצה שהן בבעלות הקבוצה ב About Land > Objects tab.
group-ability-land-return-group-set = החזרת אובייקטים שהוקצו לקבוצה
group-ability-land-return-group-set-help = החזרת אובייקטים על חבילות בבעלות קבוצה שהוקצו לקבוצה ב About Land > Objects tab.
group-ability-land-return-non-group = החזרת אובייקטים שאינם בקבוצה
group-ability-land-return-non-group-help = החזרת אובייקטים על חבילות בבעלות קבוצה שאינן קבוצתיות ב-About Land > Objects tab.
group-ability-land-gardening = שימוש בצמחים ממשפחת הלימון.
