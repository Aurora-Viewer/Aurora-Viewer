# Director — capture and animations
director-capture = Đường dẫn bằng tay
director-capture-start = Ghi lại con đường của tôi
director-capture-start-tip = Bay máy ảnh như bạn muốn nó được quay (alt-camera, camera tự do hoặc flycam): góc nhìn được giữ hai mươi lần mỗi giây, và Stop biến nó thành keyframes với tốc độ mà bạn bay.
director-capture-taking =
    Đang ghi lại đường dẫn của bạn: { $time }, { $views ->
        [one] { $views } xem
       *[other] { $views } xem
    }
director-capture-stop = Dừng và tạo khung khóa
director-capture-stop-tip = Đường dẫn sẽ trở thành khung chính sau khi kết thúc đoạn nhạc, theo tốc độ mà bạn đã bay qua nó. Ctrl+Z lấy lại nó.
director-capture-cancel-tip = Bỏ đi con đường này (Escape).
director-capture-detail = Chi tiết
director-capture-detail-tip = Các keyframes theo đường đi của bạn gần như thế nào: chi tiết hơn giữ các chuyển động nhỏ hơn, với nhiều keyframe.
director-capture-hint = Đường dẫn của bạn sẽ được thêm sau khi kết thúc đoạn nhạc, hoặc trở thành đoạn khi nó trống.
director-capture-done =
    Con đường của anh đã trở thành { $count ->
        [one] { $count } khung chìa khóa
       *[other] { $count } khung khóa
    } trên { $time }.
director-capture-short = Đường đi quá ngắn để chơi: ghi lại lâu hơn một chút.
director-capture-full = Đường ray không còn chỗ cho con đường này.
director-capture-dropped = Đường đi bị bỏ qua: Director đóng cửa, một teleport bắt đầu hoặc RLVa hạn chế camera.
director-capture-restricted = RLVa hạn chế camera: không có đường đi nào có thể ghi lại.
director-key-anim = Di chuyển
director-key-anim-none = Không có
director-key-anim-tip = Một hoạt hình của kho của bạn mà nhân vật của bạn sẽ chơi khi đoạn nhạc đi qua khung khóa này (hoặc thả một từ kho ở đây). Dù đoạn nào đã bắt đầu sẽ dừng lại khi kết thúc chơi.
director-key-anim-missing = { $name } (thiếu)
director-key-anim-missing-tip = Hoạt hình này không còn trong kho của bạn nữa: trình chiếu sẽ bỏ qua nó.
director-key-anim-clear = Không có hoạt hình ở đây
director-key-anim-until = Cho đến khi
director-key-anim-until-tip = Ở đâu hoạt hình dừng lại: tại keyframe sau đó, hoặc khi chơi kết thúc.
director-key-anim-end = Kết thúc chơi nhạc
director-key-anim-stops = Dừng
