ui-contacts-filter-friends = Lọc bạn bè
ui-contacts-filter-groups = Nhóm bộ lọc
ui-places-filter-places = Địa điểm lọc
ui-texture-picker-filter-materials = Tính chất bộ lọc
ui-contacts-filter-people = Lọc người
ui-appearance-filter-outfits = Bộ trang phục lọc
common-filter-textures = Hình dạng bộ lọc
ui-appearance-filter-wearable-items = Lọc các mục có thể đeo
ui-inventory-controls-filters = Bộ lọc
ui-inventory-controls-inventory-filters = Bộ lọc kho
ui-inventory-controls-filters-2 = Bộ lọc •
