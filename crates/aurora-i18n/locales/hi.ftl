director-capture = पथ हस्तचालित
director-capture-start = मेरा पथ रिकॉर्ड करें
director-capture-start-tip = कैमरा को उड़ान भरने दें जैसा आप चाहते हैं कि यह फिल्माया जाए (ऑल्ट-कैमरा, फ्री कैमरा या फ्लाइकैम): दृश्य एक सेकंड में बीस बार रखा जाता है और स्टॉप इसे आपके उड़ने की गति पर कीफ्रेमों में बदल देता है।
director-capture-taking =
    अपना पथ रिकॉर्ड करें: { $time }, { $views ->
        [one] { $views } दृश्य
       *[other] { $views } दृश्य
    }
director-capture-stop = रोकें तथा कुंजी फ्रेम बनाएँ
director-capture-stop-tip = ट्रैक के अंत के बाद पथ कुंजी फ्रेम बन जाता है, जिस गति से आप इसे फ्लाई करते हैं. कंट्रोल+Z इसे वापस लेता है.
director-capture-cancel-tip = इस पथ को छोड़ें (एस्केप)
director-capture-detail = विस्तृत
director-capture-detail-tip = कुंजी फ्रेम आपके पथ को कितना निकटता से अनुसरण करते हैं: अधिक विवरण अपने छोटे चालों को बनाए रखता है, अधिक कुंजी फ़्रेम के साथ.
director-capture-hint = ट्रैक के अंत के बाद आपका पथ जोड़ा जाता है, या जब यह खाली हो तो ट्रैक बन जाता है.
director-capture-done =
    आपका पथ बन गया { $count ->
        [one] { $count } कुंजी फ्रेम
       *[other] { $count } कुंजी फ्रेम
    } ऊपर { $time }.
director-capture-short = पथ बजाने के लिए बहुत छोटा है: थोड़ा अधिक रिकॉर्ड करें.
director-capture-full = इस पथ के लिए ट्रैक में कोई जगह नहीं बची है.
director-capture-dropped = पथ छोड़ दिया गया: निर्देशक बंद हो गया, एक टेलीपोर्ट शुरू हुआ या RLVa ने कैमरा को सीमित कर दिया।
director-capture-restricted = RLVa कैमरा को प्रतिबंधित करता है: कोई पथ रिकॉर्ड नहीं किया जा सकता.
director-key-anim = एनिमेशन
director-key-anim-none = कोई नहीं
director-key-anim-tip = जब ट्रैक इस कुंजी फ्रेम को पार करता है (या इनवेस्टमेंट से एक यहाँ छोड़ता है) तो आपका अवतार बजाएगा आपके इन्वेंट्री का एक एनिमेशन. जो भी ट्रैक प्रारंभ किया गया है वह प्लेबैक समाप्त होने पर रुक जाता है.
director-key-anim-missing = { $name } (लापता)
director-key-anim-missing-tip = यह एनिमेशन अब आपके सूचीपत्र में नहीं है: प्लेबैक इसे छोड़ देता है.
director-key-anim-clear = यहाँ कोई एनिमेशन नहीं है
director-key-anim-until = जब तक
director-key-anim-until-tip = जहां एनिमेशन रुकता है: बाद के कीफ्रेम पर, या जब प्लेबैक समाप्त होता है.
director-key-anim-end = प्लेबैक का अंत
director-key-anim-stops = रोकता है
director-key-anim-stops-tip = एक एनिमेशन जो पहले की फ्रेम से प्रारंभ हुआ है, यहाँ रुकता है.
director-key-anim-stops-clear = इसे खेलने दो
director-key-lens-time = लेंस तथा दिन का समय
director-key-aperture = एपर्चर
director-key-aperture-tip = इस कुंजी फ्रेम की क्षेत्र गहराई; दो कुंजी फ़्रेम के बीच यह सुचारू रूप से बदलता है.
director-key-focus = फोकस
director-key-focus-tip = ट्रैक के बजाय इस कुंजी फ्रेम को फोकस करने की दूरी (लक्ष्य या इसका फोकस दूरी).
director-key-hour = दिन का समय
director-key-hour-tip = इस कुंजी फ्रेम पर सूर्य, सिर्फ आपके अपने दृश्य में: क्षेत्र को कुछ नहीं भेजा जाता है. दो कुंजी फ़्रेम के बीच यह सुचारू रूप से चलता है; जब प्लेबैक समाप्त होता है तो आपका अपना आकाश वापस आता है.
director-key-track-value = ट्रैक का मूल्य
director-key-live = स्तर
director-key-set = सेट
director-key-set-tip = इस कुंजी फ्रेम को अपने आप में एक मूल्य दें.
director-key-unset = ट्रैक के मूल्य पर वापस जाएँ
director-key-unset-live = लाइव आकाश में वापस जाएँ
director-title = डायरेक्टर
director-tab-track = ट्रैक
director-tab-camera = कैमरा
director-tab-look = देखो
director-tab-output = आउटपुट
director-tab-library = लाइब्रेरी
director-tab-filters = फ़िल्टर
director-filters-note = फोटो विंडो के फ़िल्टर और LUTs: फोटो और फिल्मों के लिए एक स्टैक. ट्रैक को फिल्माया जाता है और इसके साथ रेंडर किया जाता है.
director-freeze-world-tip = फोटो विंडो में जैसा: अवतार, एनिमेशन और जो कुछ भी चल रहा है उसे स्थिर रखें, कैमरा मुक्त रहता है. एक ट्रैक जो एक ठंडी दुनिया के माध्यम से खेला जाता है एक स्थिर क्षण के आसपास घूमता है.
director-thumb-missing-tip = इस दृश्य का अभी तक कोई छवि नहीं है: यह तब लिया जाता है जब कुंजी फ्रेम रखा या अद्यतन किया जाता है, पर जाएँ, और जब ट्रैक इसे पार करता है.
director-camera = कैमरा
director-lens = दृश्य कोण
director-roll = सूची (L)
director-roll-reset = दृश्य को स्तरित करें
director-free-camera = मुक्त कैमरा
director-free-camera-tip = कैमरा अवतार को छोड़ देता है: गति कुंजी के साथ इसे उड़ान भरें, दाएँ माउस बटन के साथ चारों ओर देखें।
director-free-speed = गति
director-keyframe-title = कुंजी फ्रेम
director-keyframe-none = संपादन के लिए टाइमलाइन पर या दुनिया में एक कुंजी फ्रेम चुनें.
director-keyframe = कुंजी फ्रेम { $number }
director-keyframe-at = कुंजी फ्रेम { $number } पर { $time }
director-key-time = समय
director-go-to = यहाँ जाएँ
director-go-to-tip = इस कुंजी फ्रेम पर कैमरा को खिसकाएँ, इसे देखने या समायोजित करने के लिए. कुंजी फ़्रेम पर दोहरा क्लिक भी वही करता है.
director-update = अद्यतन
director-update-tip = इस कुंजी फ्रेम को मौज़ूदा दृश्य के साथ बदलें.
director-delete = मिटाएँ (D)
director-path = पथ
director-curve-smooth = वक्र
director-curve-linear = सीधी रेखाएँ
director-even-speed = समान गति
director-even-speed-tip = समयरेखा पर कुंजी फ्रेम को खिसकाएँ ताकि कैमरा पूरे पथ के साथ समान गति बनाए रखे. अवधि बदलती नहीं है.
director-ease = सुचारू प्रारंभ तथा अंत
director-ease-tip = कैमरा आराम से पहले की फ्रेम को छोड़ देता है और अंतिम पर आराम करने आता है।
director-show-path = विश्व में पथ दिखाएँ
director-summary =
    { $count ->
        [one] { $count } कुंजी फ्रेम
       *[other] { $count } कुंजी फ्रेम
    } · { $seconds } s · { $meters } m
director-playback = प्लेबैक
director-start-delay = प्रारंभ देरी
director-start-delay-tip = पहला दृश्य कैमरा छोड़ने से पहले लंबे समय तक आयोजित किया जाता है, इंटरफेस पहले से ही छिपा हुआ है: रिकॉर्डिंग शुरू करने के लिए समय।
director-hide-huds = खेलते समय HUDs छुपाएँ
director-loop = लूप
director-clear = ट्रैक साफ करें
director-clear-tip = ट्रैक साफ करें: प्रत्येक कुंजी फ्रेम जाता है (पहले पूछा गया; पूर्ववत उन्हें वापस लाता है)
director-clear-confirm = ट्रैक साफ करें?
director-clear-confirm-text =
    { $count ->
        [one] इसका कुंजी फ्रेम मिटाया गया है. पहले जैसा (Ctrl+Z) इसे वापस लाता है.
       *[other] इसका { $count } कुंजी फ्रेम मिटाए गए हैं. पूर्ववत (Ctrl+Z) उन्हें वापस लाता है.
    }
director-clear-action = साफ करें
director-environment = वातावरण
director-rewind = प्रारंभ में वापस जाएँ
director-play = ट्रैक बजाएँ. इंटरफ़ेस छुपा है; एसकेप रोकता है.
director-play-needs-keys = ट्रैक को बजाने के लिए कम से कम दो कुंजी फ्रेम जोड़ें.
director-restricted = RLVa कैमरा को सीमित करता है: ट्रैक बजाया नहीं जा सकता और दृश्य तालाबंद नहीं किया जा सकता.
director-add-keyframe = कुंजी फ्रेम
director-add-keyframe-tip = मौज़ूदा दृश्य के साथ एक कुंजी फ्रेम जोड़ें: कैमरा कहाँ है, यह कहां दिखता है और इसका दृश्य कोण.
director-track-full = ट्रैक भरा है.
director-starts-in =
    { $seconds ->
        [one] में प्रारंभ होता है { $seconds } सेकण्ड
       *[other] में प्रारंभ होता है { $seconds } सेकण्ड
    }
director-stop-hint = रोकने के लिए Esc
director-key-time-tip = जब कैमरा इस कुंजी फ्रेम पर होता है. केवल यह कुंजी फ़्रेम ही अपने दो पड़ोसियों के बीच चलता है.
director-span-time = खण्ड अवधि
director-span-time-tip = पिछले कुंजी फ्रेम से इस एक के लिए कैमरा द्वारा लिया गया समय. इसके बाद के कुंजी फ़्रेम इसके साथ चलते हैं, इसलिए अन्य खण्ड अपनी गति बनाए रखते हैं.
director-span-speed = खण्ड गति
director-span-speed-tip = पिछले कुंजी फ्रेम से इस एक तक कैमरा की औसत गति. नई गति खण्ड की अवधि को बदलती है; इसके बाद के कुंजी फ़्रेम इसके साथ चलते हैं.
director-span-speed-still = कैमरा इस खण्ड पर नहीं खिसकता: यह सिर्फ घूमता है या ज़ूम करता है. इसके बजाए इसकी अवधि सेट करें.
director-duration = कुल अवधि
director-duration-tip = प्रत्येक खण्ड को समान रूप से लम्बा या छोटा करता है: पूरा ट्रैक धीमी या तेज़.
director-keyframe-hint = खींचें: इसे समय में खिसकाएँ. शिफ़्ट + खीचें: इसके बाद भी कुंजी फ्रेम को खिसकाना. दोहरा क्लिक: इस पर जाएँ.
director-keyframe-pick-hint = कंट्रोल+क्लिक: इसे चयन में जोड़ें या बाहर लें. शिफ्ट+क्लिक्स: इसके ऊपर सभी कुंजी फ्रेम चुनें.
director-key-group = { $count } चुने गए कुंजी फ्रेम: एक विन्यास जो यहाँ पर बदला गया है, उन सभी में जाता है (उनका स्थान, शीर्षक तथा समय उनके अपने रहते हैं).
director-key-rest = इस कुंजी फ्रेम पर रोकें
director-key-rest-tip = कैमरा इस कुंजी फ्रेम पर रुकने के लिए धीमी हो जाती है और इसे धीरे से छोड़ देती है, बजाय गति से गुजरने के. केवल वक्र के साथ.
director-key-lock = लक्ष्य पर दृश्य तालाबंद करें
director-key-lock-tip = इस कुंजी फ्रेम का अपना ताला, चाहे अन्य कुंजी फ़्रेम और लाइव कैमरा के क्या हो. चालू, यह अपने लक्ष्य को देखता है जब ट्रैक बजाया जाता है (बंद लक्ष्य, जब इसे चालू किया जाता है तो लिया जाता है); बंद, जहां इसका कैमरा रखा गया था.
director-key-aim = देखता है
director-key-aim-tip = जब ट्रैक इस कुंजी फ्रेम को बजाता है तो दृश्य क्या देखता है. दो कुंजी फ़्रेम के बीच, यह एक से दूसरे में आसानी से बदल जाता है.
director-key-aim-lock-on = ताला का लक्ष्य: { $target }
director-key-aim-lock-off = जहाँ इसका कैमरा रखा गया है (यह ताला का अनुसरण करता है, जो बंद है)
director-key-aim-free = जहाँ इसका कैमरा रखा गया है
director-aim-joint = { $target } · { $joint }
director-key-aim-take = ताला के लक्ष्य का उपयोग करें
director-key-aim-take-tip = यह कुंजी फ्रेम ताला के अंतर्गत चुने गए लक्ष्य को देखता है, जैसा कि यह अब है. जब ताला लक्ष्य बदलता है या बंद हो जाता है तो यह इसे बनाए रखता है.
director-hide-pointer = बजाने के दौरान माउस संकेतक छुपाएँ
director-lock = तालाबंद
director-lock-on = लक्ष्य पर दृश्य तालाबंद करें
director-lock-on-tip = लक्ष्य दृश्य के केंद्र में रहता है जहाँ भी आप कैमरा को खिसकाते हैं, बिना किसी कुंजी फ्रेम की आवश्यकता के. जब दृश्य तालाबंद होता है तब जोड़ा गया एक कुंजी फ़्रेम इस लक्ष्य पर ताला लगाया जाता है, यहां तक कि यदि आप बाद में दूसरा चुनते हैं; प्रत्येक कुंजीफ्रेम अपने ताला रखता है, ट्रैक टैब की अपनी पंक्ति में सेट किया जाता है.
director-lock-target = लक्ष्य
director-lock-own = मेरा अवतार
director-lock-avatar = अन्य अवतार
director-lock-object = एक वस्तु
director-lock-pick-own = मेरा अवतार
director-lock-pick-focus = कैमरा फोकस
director-lock-pick-focus-tip = ऑल्ट + क्लिक एक अवतार या वस्तु पर कैमरा को फोकस करने के लिए, फिर इस बटन को दबाएँ: दृश्य उस अवतार (यहां तक कि वह क्या पहनता है) या उस वस्तु पर ताला लगा देता है.
director-lock-joint = मुख्य भाग
director-lock-smoothing = स्मूथिंग
director-lock-smoothing-tip = कितना समय दृश्य को लक्ष्य के साथ पकड़ने में लगता है.0पर यह हर चाल का अनुसरण करता है, नृत्य के प्रत्येक कदम शामिल हैं; अधिक, यह कैमरा ऑपरेटर की तरह अनुसरण करते हैं.
director-lock-lost = एक लक्ष्य दृष्टि में नहीं है: जहां इसे देखा जाता है, दृश्य मुक्त है।
director-joint-head = शीर्ष
director-joint-neck = गर्दन
director-joint-chest = छाती
director-joint-pelvis = पेल्विस
director-joint-left-hand = बायाँ हाथ
director-joint-right-hand = दायाँ हाथ
director-picture = छवि
director-format = फ़ॉर्मेट
