    } a { $files ->
    [one] { $files } conversazione.
   *[other] { $files } conversazioni.
    }
ui-options-chat-logs-import-reopen = Una conversazione già in corso li mostra alla prossima apertura.
ui-options-chat-logs-import-nothing = Nulla di nuovo da importare.
ui-options-chat-logs-import-failed = { $count ->
    [one] { $count } file non è stato importato ed è rimasto com'era: importare di nuovo per riprovare.
   *[other] { $count } file non sono stati importati e sono rimasti com'erano: importare di nuovo per riprovare.
    }
ui-options-chat-logs-import-left-out = { $count ->
    [one] { $count } file di testo non ha marcature temporali ed è stato escluso: potrebbe essere una conversazione registrata senza di esse.
   *[other] { $count } file di testo non hanno marcature temporali e sono stati esclusi: potrebbero essere conversazioni registrate senza di esse.
    }
