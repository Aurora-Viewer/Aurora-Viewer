        [one] { $count } Tiedosto on siirretty.
       *[other] { $count } Tiedostot on siirretty.
    }
ui-options-chat-logs-move-failed = Tiedostoja ei voi siirtää: edellinen kansio säilytetään.
ui-options-chat-logs-erase = Poista tämän tilin historia…
ui-options-chat-logs-erase-title = Poista tämän tilin historia?
ui-options-chat-logs-erase-text = Kaikki tämän tilin keskustelutiedostot poistetaan levystä: pikaviestit, ryhmät, konferenssit ja lähellä olevat keskustelut. Tätä ei voi peruuttaa. Muihin tileihin ei kosketa. Kopiota yksityisistä keskustelusta, jota ruudukko pitää, ei poisteta: Aurora lakkaa näyttämästä viestejään vanhempia kuin tämä poisto.
ui-options-chat-logs-erase-confirm = Poista
ui-options-chat-logs-no-account = Kirjaudu sisään nähdäksesi tämän tilin kansio.
