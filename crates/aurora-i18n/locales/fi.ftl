    }
director-clear-action = Tyhjennä
director-environment = Ympäristö
director-rewind = Takaisin alkuun
director-play = Toista raita. Käyttöliittymä on piilotettu; Esc pysäyttää toiston.
director-play-needs-keys = Lisää vähintään kaksi avainkehystä, jotta voit toistaa raidan.
director-restricted = RLVa rajoittaa kameran toimintaa: raitaa ei voi toistaa eikä näkymää voi lukita.
director-add-keyframe = Avainkehys
director-add-keyframe-tip = Lisää avainkehys, jossa on nykyinen näkymä: missä kamera on, mihin se näyttää ja sen katselukulma.
director-track-full = Rata on täynnä.
