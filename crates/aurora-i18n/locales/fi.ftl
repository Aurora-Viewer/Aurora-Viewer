director-keyframe-at = Avainkehys { $number } 10 mg/ vrk { $time }
director-key-time = Aika
director-go-to = Siirry
director-go-to-tip = Siirrä kamera tähän avainkehykseen, jos haluat katsoa sen läpi tai säätää sitä.Tuplaklikkaamalla avainkuvaa tehdään sama asia.
director-update = Päivitys
