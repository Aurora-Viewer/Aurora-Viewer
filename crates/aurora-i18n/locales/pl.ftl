    [few] { $count } klatki kluczowe
    [many] { $count } klatek kluczowych
   *[other] { $count } klatki kluczowej
    }.
director-capture-short = Trasa była zbyt krótka do odtworzenia: nagraj nieco dłuższą.
director-capture-full = Na ścieżce nie ma już miejsca na tę trasę.
director-capture-dropped = Trasa została porzucona: zamknięto Reżysera, rozpoczął się teleport lub RLVa ograniczyło kamerę.
director-capture-restricted = RLVa ogranicza kamerę: nie można nagrywać żadnej trasy.
director-key-anim = Animacja
director-key-anim-none = Brak
director-key-anim-tip = Animacja z szafy, którą awatar odtwarza, gdy ścieżka mija tę klatkę kluczową (można też upuścić tutaj animację z szafy). Wszystko, co uruchomiła ścieżka, zatrzymuje się po zakończeniu odtwarzania.
director-key-anim-missing = { $name } (brak)
director-key-anim-missing-tip = Tej animacji nie ma już w szafie: odtwarzanie ją pomija.
director-key-anim-clear = Bez animacji
director-key-anim-until = Do
