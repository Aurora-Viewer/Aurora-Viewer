    [many] { $views } widoków
   *[other] { $views } widoku
    }
director-capture-stop = Zatrzymaj i utwórz klatki kluczowe
director-capture-stop-tip = Trasa staje się klatkami kluczowymi za końcem ścieżki, w tempie lotu. Ctrl+Z cofa tę zmianę.
director-capture-cancel-tip = Porzuć tę trasę (Escape).
director-capture-detail = Szczegółowość
director-capture-detail-tip = Jak dokładnie klatki kluczowe odwzorowują trasę: większa szczegółowość zachowuje drobniejsze ruchy, kosztem większej liczby klatek kluczowych.
director-capture-hint = Trasa jest dodawana za końcem ścieżki lub staje się ścieżką, gdy ta jest pusta.
director-capture-done = Z trasy trwającej { $time } utworzono { $count ->
