ui-options-chat-logs-import-left-out = { $count ->
    [one] { $count } plik tekstowy nie ma znaczników czasu i został pominięty: może to być rozmowa zapisana bez nich.
    [few] { $count } pliki tekstowe nie mają znaczników czasu i zostały pominięte: mogą to być rozmowy zapisane bez nich.
    [many] { $count } plików tekstowych nie ma znaczników czasu i zostało pominiętych: mogą to być rozmowy zapisane bez nich.
   *[other] { $count } pliku tekstowego nie ma znaczników czasu i zostało pominiętych: mogą to być rozmowy zapisane bez nich.
    }
