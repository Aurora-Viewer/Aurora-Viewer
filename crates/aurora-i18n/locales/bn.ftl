contents-copy-complete =
    { $count ->
        [one] বিষয়বস্তু "- এ অনুলিপি করা হয়েছে{ $folder }": { $count } আইটেম গ্রহণ করা হয়েছে ।
       *[other] বিষয়বস্তু "- এ অনুলিপি করা হয়েছে{ $folder }": { $count } আইটেম পাওয়া গেছে ।
    }
contents-copy-timeout = এখানে অনুলিপি করো{ $folder }" ৬০ সেকেন্ডের মধ্যে নিশ্চিত করা যায়নি । প্রাপ্ত বস্তু: { $received }/{ $count }ফোল্ডারের বিষয়বস্তু পরীক্ষা করো
contents-copy-unavailable = এখানে অনুলিপি করো{ $folder }" নিশ্চিত করা যায়নি: গন্তব্য ফোল্ডারটি অনুপস্থিত অথবা লোড করা যায় নি ।
contents-copy-wear-busy = বিষয়বস্তু "- এ অনুলিপি করা হয়েছে{ $folder }", কিন্তু আপনার পোশাক পরিবর্তন করা যায়নি যখন অন্য পোশাকের পরিবর্তন অপেক্ষমান ছিল। আপনার ইনভেস্টমেন্ট থেকে ফোল্ডারটি পরুন।
contents-copy-failed = অবজেক্টের বিষয়বস্তুর জন্য ফোল্ডার তৈরি করা যায়নি: { $reason }
contents-copy-wear-timeout = "% 1" এর প্রত্যেকটি বস্তু নয়{ $folder }" আপনার ইনভেস্টমেন্টে পৌঁছে গেছে: আপনার পোশাক পরিবর্তন করা হয়নি। আপনার ইনভেন্টরি থেকে ফোল্ডারটি পরুন।
