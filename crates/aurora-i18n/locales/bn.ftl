director-library-deleted = মুছে ফেলা হয়েছে: { $name }
director-library-imported = আমদানি করা হয়েছে: { $name }
director-library-imported-name = আমদানি করা হয়েছে
director-library-exported = রপ্তানি করা হয়েছে: { $name }
director-library-too-large = এই ফাইলটি একটি ট্র্যাক বা মন্টেজ হিসেবে ব্যবহারের জন্য খুব বড়।
director-library-unreadable = এই ফাইলটি একটি ট্র্যাক বা মন্টেজ নয়, অথবা এটি ক্ষতিগ্রস্ত।
director-library-version = এই ফাইলটি একটি নতুন প্রদর্শক দ্বারা তৈরি করা হয়েছে (সংস্করণ { $version }): এটি খুলতে Aurora আপডেট করুন।
director-montage = সংযোজন
director-montage-empty = এখনো কোন গান নেই: সংরক্ষিত ট্র্যাকগুলো পরপর চালানোর জন্য যোগ করুন।
director-montage-shot-missing = বাদ দেওয়া, ছাড়ো
director-montage-shot-short = একটি কীফ্রেম, ছাড়ো
director-montage-shot-unusable = অব্যবহৃত, ছাড়ো
director-montage-skipped-tip = এই চিত্রটি ছাড় দেওয়া হয়েছে: এর ট্র্যাক অনুপস্থিত, পড়া যায়নি অথবা এর মধ্যে দুইটির কম কীফ্রেম রয়েছে।
director-montage-up-tip = এই গুলিকে আগে সরাও
director-montage-down-tip = এই গুলি পরে সরিয়ে ফেলো
director-montage-remove-tip = এই ছবিটি মুছে ফেলো (এর ট্র্যাক সংরক্ষিত থাকবে)
director-montage-add = যোগ করো
director-montage-add-tip = মোন্টেজের শেষে সংরক্ষিত ট্র্যাকটি যোগ করুন
director-montage-add-none = প্রথমে একটি ট্র্যাক সংরক্ষণ করা হবে: মোন্টেজটি সংরক্ষিত ট্র্যাকগুলি চালানো হবে।
director-montage-total =
    { $shots ->
        [one] মোট { $time } s, { $shots } গুলি
       *[other] মোট { $time } s, { $shots } গুলি
    }
director-montage-play = মন্টেজ চালাও
director-montage-play-tip = চারটি ছবি পরপর চালাও, প্রতিটি ছবির মাঝখানে একটি কাট রাখা হবে। Esc-এর সাহায্যে বন্ধ করা যাবে; সম্পাদন করা ট্র্যাক ফিরে আসবে।
director-montage-film = চলচ্চিত্র সম্পাদনা
director-montage-film-tip = পুরো মন্টেজকে এক ছবি হিসেবে রেকর্ড করো, কাট থেকে কাট।
director-montage-nothing = কোন মোন্টেজের শ্যুটিং চালানো যাবে না: প্রতিটিতে অন্তত দুইটি কীফ্রেম সংরক্ষিত ট্র্যাক প্রয়োজন।
director-montage-restricted = ক্যামেরা সীমিত (RLVa অথবা একটি হেডসেট): মন্টেজ চালানো সম্ভব নয়।
director-montage-name = এই মঞ্চের নাম
director-montage-bad-name = প্রথমে মোন্টেজের নাম দিন ।
director-montage-save-tip = মন্টেজটি এই নামের অধীনে সংরক্ষণ করুন (এটি ট্র্যাকের নাম সংরক্ষিত রাখবে, অনুলিপি নয়)।
director-montage-none = এখনো কোন মন্টেজ সংরক্ষিত হয়নি।
director-montage-load-tip = এই মন্টেজটি লোড করুন (যেটি একসাথে রাখা হচ্ছে তা প্রতিস্থাপন করা হবে)
director-montage-delete-tip = এই মন্টেজটি মুছে ফেলুন (প্রথমে জিজ্ঞাসা করা হবে; এর ট্র্যাকগুলো থাকবে)
director-montage-delete-confirm = মোন্টেজ মুছে ফেলা হবে কি?
director-montage-delete-text = “{ $name }” এই কম্পিউটারে থেকে মুছে ফেলা হয়েছে । এটি বাতিল করা যাবে না । এর ট্র্যাক সংরক্ষিত থাকবে ।
director-montage-export = মোস্ট্যাপ রপ্তানি করো...
director-montage-export-tip = অংশীদারি করার জন্য মন্টেজ এবং এটি চালিত ট্র্যাকগুলি একটি ফাইলে সংরক্ষণ করুন।
director-montage-clear = পরিষ্কার করো
director-montage-clear-tip = মোন্টেজ থেকে প্রত্যেকটি শ্যুটিং মুছে ফেলুন (ট্রেক সংরক্ষিত থাকবে)
director-ffmpeg-title = রেকর্ডিংয়ের জন্য ffmpeg প্রয়োজন
director-ffmpeg-step-download = ffmpeg এর সাইট থেকে ডাউনলোড করুন (ডাউনলোড পৃষ্ঠা)।
director-ffmpeg-step-pack = ffmpeg ডাউনলোড করুন (Download ffmpe g), অথবা এর সাইট থেকে এটি পেতে পারেন।
director-ffmpeg-step-install-windows = এটি ইনস্টল করুন: উইন্ডোজ টার্মিনালে winget install ffmpeg; অথবা এটিকে আন-জিপ করে তার bin ফোল্ডার PATH-এ যোগ করুন।
director-ffmpeg-step-install-macos = এটি ইনস্টল করুন: টার্মিনালে, brew install ffmpeg চালান।
director-ffmpeg-step-install-linux = আপনার সিস্টেমের প্যাকেজের সাথে এটি ইনস্টল করুন (উদাহরণস্বরূপ: sudo apt install ffmpeg)।
director-ffmpeg-step-look = "আবার দেখুন" চাপুন: পুনরায় আরম্ভ করার প্রয়োজন নেই। অথবা "ffmpeg নির্বাচন করুন..." ব্যবহার করে ফাইলটি বেছে নিন।
director-ffmpeg-site-tip = আপনার ব্রাউজার-এ ffmpeg'র ডাউনলোড পৃষ্ঠা খোলা হবে
director-ffmpeg-choose-tip = ffmpeg প্রোগ্রাম (Windows-এ ffmpe g.exe) নির্বাচন করুন যদি এটি PATH-এ না থাকে
director-ffmpeg-again-tip = ffmpeg- এর জন্য আবার অনুসন্ধান করুন, বর্তমানে যে PATH- এ তা রয়েছে
director-ffmpeg-still-missing =
    { $count ->
        [one] এখনও পাওয়া যায়নি। যদি আপনি এটি ইনস্টল করেছেন, তাহলে "ffmpeg নির্বাচন করুন..." ব্যবহার করে এর ফাইলটি বেছে নিন।
       *[other] এখনো পাওয়া যায়নি ({ $count } চেষ্টা করুন। যদি আপনি এটি ইনস্টল করেছেন, তাহলে “ffmpeg নির্বাচন করুন…” ব্যবহার করে ফাইলটি বেছে নিন।
    }
director-ffmpeg-pack = ffmpeg ডাউনলোড করুন
director-ffmpeg-pack-tip = Aurora প্রকল্প দ্বারা প্রকাশিত ffmpeg ডাউনলোড করুন (এর আকার প্রথমে দেখানো হয়েছে)
director-ffmpeg-pack-confirm = ffmpeg ডাউনলোড করা হবে কি?
director-ffmpeg-pack-confirm-text = Aurora প্রকল্পের ffmpeg হল { $size } মেগাবাইট। ডাউনলোড করার পর এটি পরীক্ষা করা হয়, তারপর মিডিয়া প্লাগ- ইনগুলির পাশে রাখা হয়।
director-ffmpeg-pack-download = ডাউনলোড
director-ffmpeg-pack-progress = { $done } এর { $total } MB
director-ffmpeg-pack-preparing = পরীক্ষা করা হচ্ছে এবং ইনস্টল করা হচ্ছে…
director-ffmpeg-pack-failed = ডাউনলোড ব্যর্থ হয়েছে অথবা ফাইলটি প্রত্যাশিত নয়: কিছুই ইনস্টল করা হয়নি।
# Director — render, fades and titles
director-output-live = স্তর
director-output-render = রেন্ডার
director-output-more = আরো অপশন
director-output-format-tip = চলচ্চিত্রটি কিভাবে লেখা হবে। ffmpeg দ্বারা লেখা সম্ভব না এমন ফরম্যাট ধূসর রঙে দেখানো হয়েছে।
director-output-fps-tip = চলচ্চিত্রের প্রতি সেকেন্ডে ফ্রেম। ১২০ হলে, লাইভ চলচ্চিত্ৰে দর্শকের প্রতি সেকন্ডে ১২০টি ফ্রेम আঁকার প্রয়োজন হয়, অথবা ফ্রেমা পুনরাবৃত্তি করা হয়; একটি রেন্ডারে প্রত্যেক ফ্রেইমের উপস্থিতি রয়েছে।
director-output-quality-tip = একটি হালকা ফাইল, অথবা একটি পরিষ্কার ছবি।
director-sound = শব্দ
director-sound-tip = এই চলচ্চিত্রটি দর্শকের নিজের শব্দকে বহন করে: বিশ্বের শব্দ, সঙ্গীত এবং মিডিয়া, যে ভলিউমে আপনি সেগুলো শুনতে পাচ্ছেন।
director-sound-no-encoder = ffmpeg-এর এই ফরম্যাটের জন্য অডিও এনকোডার নেই: চলচ্চিত্রটি নিরব।
director-sound-off = প্রথমে শব্দটা চালু করো।
director-sound-ui = ইন্টারফেস শব্দ
director-sound-ui-tip = ইন্টারফেস শব্দ (ক্লিক, সতর্কবার্তা) চলচ্চিত্রেও আছে।
director-sound-voice = ভয়েস আড্ডা (অন্য ব্যক্তি)
director-sound-voice-tip = আপনার চারপাশের লোকদের কণ্ঠস্বর রেকর্ড করুন, প্রথমে তাদেরকে জিজ্ঞেস করুন।
director-sound-voice-on = ভয়েস চ্যাট রেকর্ড করা হয়েছে: অন্য লোকদের কণ্ঠও এই ভিডিওতে রয়েছে।
director-render-start = রেন্ডার
director-render-tip = ট্র্যাকটি বাস্তব সময়ে না চলচ্চিত্র করা হবে: প্রত্যেক ফ্রেম নির্বাচিত মাপের সমগ্র আঁকা হবে, কোনটিই পুনরাবৃত্তি করা হবে না বা ছেড়ে দেওয়া হবে না। দর্শকের নিজস্ব অ্যানিমেশন চলচ্চিত্ৰের ঘড়ি অনুসরণ করবে; সার্ভারের যা সরানো হয় তা তার বাস্তব সময় ধরে রাখবে।
director-render-needs-track = রেন্ডারিংয়ের জন্য অন্তত দুইটি কীফ্রেম প্রয়োজন, এবং একটি ক্যামেরা RLVa-র প্রয়োজন নেই।
director-render-png = PNG ছবি (ffmpeg নেই)
director-render-png-quality = PNG ছবি ক্ষতিমুক্ত: কোন গুণমান নির্বাচন করা যাবে না।
director-render-size = মাপ
director-render-size-tip = চলচ্চিত্রের আকার, উইন্ডোর আকার যাই হোক না কেন: ট্র্যাকের ছবির ফরম্যাট যত বড় হবে তত বড়।
director-render-window = উইণ্ডো
director-render-no-sound = একটি রেন্ডারের কোন শব্দ নেই: এর জগত বাস্তব সময়ে চলবে না।
director-render-progress = ফ্রেম { $done } এর { $count }
director-render-progress-left = ফ্রেম { $done } এর { $count }, { $left } বাম
director-render-cancel = রেন্ডারিং বন্ধ করো
director-render-cancel-tip = এটি বন্ধ করো (Escape too): ফ্রেম যা ইতিমধ্যে লেখা হয়েছে তা রাখা হবে ।
director-render-cancelled = রেন্ডারিং বন্ধ করা হয়েছে: এখন পর্যন্ত লেখা ফ্রেমগুলো সংরক্ষিত আছে।
director-render-interrupted = রেন্ডারিং বন্ধ করা হয়েছে (উইন্ডো বন্ধ, টেলিপোর্ট অথবা RLVa): এখন পর্যন্ত লেখা ফ্রেমগুলো সংরক্ষিত আছে।
director-render-draw-failed = একটি ফ্রেম আঁকা যায়নি (ভিডিও মেমরি?): ছোট আকারের ছবি ব্যবহার করুন।
director-render-write-failed = ফ্রেম লেখা যায়নি (এনকোডার অথবা ডিস্ক)।
director-fades = ফেড
director-fade-in = হ্রাস করা হবে
director-fade-in-tip = ট্র্যাকের শুরুতে কালো থেকে সেকেন্ড (০: কিছুই নেই) ।
director-fade-out = ফাদ আউট
director-fade-out-tip = ট্র্যাকের শেষে কালো রং দেখানোর জন্য সেকেন্ড (০: কিছুই নেই) ।
director-titles = শিরোনাম
director-titles-none = এখনো কোন শিরোনাম নেই।
director-title-default = শিরোনাম
director-title-empty = (খালি)
director-title-edit-tip = এই শিরোনামটি সম্পাদন করতে ক্লিক করুন ।
director-title-remove = এই শিরোনামটি সরিয়ে ফেলো
director-title-add = শিরোনাম যোগ করো
director-title-add-tip = চলচ্চিত্রের একটি শিরোনামের কার্ড।
director-title-full = একটি ট্র্যাকের সর্বোচ্চ ১৬টি শিরোনাম আছে।
director-title-text-hint = একটি বা একাধিক লাইন
director-title-text-tip = শিরোনামের টেক্সট: প্রতিটি লাইন একটি নতুন লাইন।
director-title-when = যখন
director-title-when-start = আরম্ভ
director-title-when-end = শেষ
director-title-when-range = বার
director-title-at-start = শুরু, { $seconds } s
director-title-at-end = শেষ, { $seconds } s
director-title-range = { $from } এ থেকে { $to } s
director-title-length = দৈর্ঘ্য
