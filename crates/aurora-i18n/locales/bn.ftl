ui-options-reset-section-text = এই পাতার বৈশিষ্ট্য তাদের ডিফল্ট অবস্থায় ফিরে যাবে । অন্যান্য পাতা পরিবর্তন করা হবে না ।
ui-options-reset-confirm = রিসেট করুন
ui-options-reset-page = পুনরায় আরম্ভ { $page }…
ui-options-page-was-reset = { $page }: ডিফল্ট সেটিংস
ui-options-all-were-reset = প্রত্যেকটি সেটিংস তার ডিফল্ট অবস্থায় ফিরে আসে
ui-options-modified-were-reset = পরিবর্তিত বৈশিষ্ট্যগুলি তাদের ডিফল্ট অবস্থায় ফিরে এসেছে
ui-options-changes-apply-immediately = পরিবর্তনগুলি অবিলম্বে প্রয়োগ করা হবে
ui-options-search-settings = একটি বৈশিষ্ট্য অনুসন্ধান করুন…
ui-options-search-title = অনুসন্ধান
ui-options-search-found =
    { $count ->
        [one] একটি সেটিংস
       *[other] { $count } সেটিংস
    } “-এর জন্য{ $query }’-এ { $pages ->
        [one] একটি পৃষ্ঠা
       *[other] { $pages } পৃষ্ঠা
    }, এখানে পরিবর্তন করতে
ui-options-search-none = কোন বৈশিষ্ট্য মিলছে না “{ $query }অন্য শব্দ চেষ্টা করুন: “shadow”, “toast”, “Ctrl+M”, “gtp”…
ui-options-modified-settings = পরিবর্তনকৃত সেটিংস
ui-options-modified-count =
    { $count ->
        [one] একটি বৈশিষ্ট্য ডিফল্ট থেকে ভিন্ন।
       *[other] { $count } সেটিংস তাদের ডিফল্ট থেকে ভিন্ন।
    }
ui-options-modified-none = প্রত্যেকটি সেটিংস তার ডিফল্ট অবস্থায় আছে।
ui-options-modified-empty = এখনো কিছুই পরিবর্তন করা হয়নি । আপনি যে সব বৈশিষ্ট্য পরিবর্তন করেছেন, সেগুলি এখানে দেখানো হয়েছে, এবং ডিফল্ট অবস্থায় ফিরে যাওয়ার পথও রয়েছে ।
ui-options-modified-reset-all = সবগুলো রিসেট করো...
ui-options-modified-reset-title = পরিবর্তিত বৈশিষ্ট্য পুনরায় নির্ধারণ করা হবে কি?
ui-options-modified-reset-text = আপনি যেকোন বৈশিষ্ট্য পরিবর্তন করলে তা ডিফল্ট অবস্থায় ফিরে আসবে। কিছুক্ষণের জন্য আপনি সেগুলি বাতিল করতে পারবেন।
ui-options-modified-reset = পরিবর্তিত: ডিফল্ট মান পুনরায় নির্ধারণ করতে ক্লিক করুন
ui-options-open-page = পৃষ্ঠাটি খুলুন
ui-options-go-to-setting = এই সেটিংস- এ যান
ui-options-show-related = বার্তা দেখাও { $count } সম্পর্কিত সেটিংস
ui-options-hide-related = টুলবার আড়াল করো { $count } সম্পর্কিত সেটিংস
ui-options-section-world = বিশ্ব এবং রেন্ডারিং
ui-options-section-communication = যোগাযোগ
ui-options-section-system = সিস্টেম
ui-options-page-media = মিডিয়া
ui-options-page-appearance = আকার
ui-options-page-confirmations = নিশ্চিতকরণ
ui-options-page-controls = মাউস এবং কীবোর্ড
ui-options-page-system = ভাষা ও আপডেট
ui-options-about-graphics = ছবির গুণমান, আলো, প্রতিফলন, পানি এবং সুষমতা।
ui-options-about-camera = দৃষ্টিভঙ্গি, নড়াচড়া, আচরণ এবং মাউস-ল্যাক।
ui-options-about-avatars = নামের ট্যাগ, নাম, লক্ষ্যবস্তু এবং অ্যানিমেশনের আভাটার দিকে তাকাও।
ui-options-about-chat = নিকটবর্তী আড্ডা, বিজ্ঞপ্তি, সতর্কবার্তা, ইতিহাস এবং স্বয়ংক্রিয় উত্তর।
ui-options-about-sound = ডিভাইস, ভলিউম, ইন্টারফেস শব্দ এবং কণ্ঠ ।
ui-options-about-media = ওয়েব পেজ এবং ভিডিও, বস্তু, হিউড এবং আভাটার উপর।
ui-options-about-privacy = কে আপনাকে দেখতে বা বার্তা পাঠাতে পারবেন এবং অন্যরা ও স্ক্রিপ্ট আপনার সম্পর্কে কী জানতে পারবে, তা ঠিক করুন।
ui-options-about-protections = প্রতিটি উৎস থেকে স্প্যাম-এর সীমা, এবং ওয়েব লিঙ্ক কতটা বিশ্বাসযোগ্য।
ui-options-about-rlva = স্ক্রিপ্টকৃত নিষেধাজ্ঞা (RestrainedLove API): আপনি যে বস্তুটি পরেন বা যার উপর বসে থাকেন তা লক করা যেতে পারে, এবং এই নিষেধ এখন সক্রিয়।
ui-options-about-layout = বার, উইন্ডো, বিশ্বের উপরে ঘোরা এবং শুরুতে যা খোলা হবে ।
ui-options-about-appearance = ফন্ট, টেক্সটের মাপ, রং এবং স্কিন ।
ui-options-about-accessibility = দেখতে, পড়তে এবং শুনতে সহজ করতে: সেটিংস যা সাহায্য করে, প্রতিটি পৃষ্ঠা থেকে।
ui-options-fun = শুধু মজা করার জন্য
ui-options-about-fun = ছোট ছোট জিনিস নিয়ে খেলা, সব বন্ধ হয়ে যায় যখন তুমি সেগুলো চালু করো।
ui-options-section-extras = অতিরিক্ত
ui-options-fun-plates = নামের প্লেট
ui-options-fun-classic-tags = এই অপশনগুলি নামের প্লেটের সাথে খেলে: অরোরা পৃষ্ঠায় নির্বাচিত ক্লাসিক নাম ট্যাগগুলি তাদের অবস্থান অনুযায়ীই থাকে।
ui-options-fun-reduced-motion = "এনিমেশন কমানো" সেটিংস সক্রিয় করা হয়েছে: প্লেটগুলো ভাসবে না এবং কাটার এর প্রভাব ছাড়াই প্রদর্শিত হবে।
ui-options-fun-jiggle = নামের প্লেট
ui-options-fun-jiggle-help = পয়েন্টার যখনই একটি প্লেটের কাছে পৌঁছাবে তখনই প্লেটটি জেলির মত ভঙ্গুর হয়ে পড়বে, আর কোন অপেক্ষা করার প্রয়োজন নেই: আপনি যত বেশি ঘোরাফেরা করবেন, তত বেশি ভঙ্গুকি অনুভব করবে । যে প্লেটে বড় হওয়ার সময় তার আকার বেড়ে যায় এবং সেটি স্থির হয়ে যায় ।
ui-options-fun-click-combo = ক্লিক কম্বো কাউন্টার
ui-options-fun-click-combo-help = প্লেটের উপর প্রতিটি ক্লিক গণনা করা হয়, এবং প্রত্যেক অধিবাসীর সংখ্যা এই কম্পিউটারে সংরক্ষিত থাকে (কিছুই প্রেরণ করা হয় না)। পাঁচ সেকেন্ডের মধ্যে পাঁচবার ক্লিক করলে একটি কমবো শুরু হয়: প্লেটটির কোণ থেকে একটি কাউন্টার পপ-আপ করে, প্রতিটি क्लिক এটিকে আঘাত করে, এবং স্ট্রিক গরম হয়ে যায়। প্লেটে ক্লিক করার পর আর কিছুই হয় না, যদি না অ্যাভাটার্স পৃষ্ঠায় প্লেটিতে ক্লিক কর্ম নির্বাচন করা হয়।
ui-options-fun-try = চেষ্টা করো
ui-options-fun-try-help = একটি নমুনা প্লেট: উপরের অপশনগুলো পরীক্ষা করার জন্য এটির ওপর মাউস রেখে ক্লিক করুন। এর ক্লিক সংরক্ষণ করা হয় না।
ui-fun-cat-warning-title = সামনের দিকে ঝলমলে আলো
ui-fun-cat-warning-body = এরপর যা ঘটে তা হল ঝলকানি: সঙ্গীতের সাথে সাথে সমগ্র দৃশ্যের রং এবং উজ্জ্বলতা দ্রুত পরিবর্তন হয়। এটি আলোক সংবেদনশীল এপিলেপসিতে আক্রান্ত ব্যক্তিদের মধ্যে সংক্রমণ সৃষ্টি করতে পারে, এমনকি এমন ব্যক্তির ক্ষেত্রেও যারা আগে কখনো এপিলেটস ছিল না।
ui-fun-cat-warning-calm = "এনিমেশন কমানো" (পছন্দ › প্রবেশযোগ্যতা) সক্রিয় হলে, প্রদর্শনীটি শান্ত হবে এবং ফ্ল্যাশ করবে না।
ui-fun-cat-warning-video = এর সঙ্গীত ইউটিউব থেকে আসে, এবং এটি একটি আলাদা উইন্ডোতে দেখানো হয়।
ui-fun-cat-warning-ask = শুধুমাত্র যদি আপনি বা এই পর্দাটি দেখতে কেউ epileptic না হয় অথবা ঝলমলে আলোর জন্য সংবেদনশীল হয় তাহলে চালিয়ে যাও।
ui-fun-cat-warning-confirm = আমি এপিলেপ্টিক নই: শুরু করো
ui-fun-cat-stop-hint = পালিয়ে যাওয়াও এটাকে থামাবে।
ui-fun-cat-unavailable = ঘুরে বেড়ানো বিড়ালের সঙ্গীতের প্রয়োজন, যা ইউটিউব থেকে বাজানো হয়: দর্শকের মিডিয়া প্লাগইন ইনস্টল করা আবশ্যক এবং ইউটিউর প্রাকদর্শন আড়াল করা উচিত নয় (পছন্দ › চ্যাট)।
ui-options-about-confirmations = অরোরা কাজ করার আগে কি জিজ্ঞেস করে, অঞ্চলের সতর্কতা, এবং প্রত্যেক সতর্কবার্তা আপনি আবার দেখতে না নির্বাচন করেছেন.
ui-options-about-inventory = ইনভেস্টরি উইন্ডোর পছন্দের বৈশিষ্ট্য এবং প্রাপ্ত বস্তুর ফাইলিং।
ui-options-about-controls = সেন্সিটিভিটি, মাটিতে দুবার ক্লিক করো এবং মোশন কী ব্যবহার করো।
ui-options-about-commands = আড্ডা বার-এ টাইপ করা কমান্ড। সহায়তার জন্য নামের উপর মাউস রেখে দিন।
ui-options-about-system = ইন্টারফেস ভাষা, নতুন সংস্করণ এবং দ্বিতীয় জীবন লিঙ্ক।
ui-options-about-network = ব্যান্ডউইথ, ডিস্ক ক্যাশ, প্রক্সি, লগ ও ডিবাগ করার সরঞ্জাম।
ui-options-tab-world-and-interface = বিশ্ব এবং ইন্টারফেস
ui-options-tab-sky-and-environment = আকাশ এবং পরিবেশ
ui-options-tab-reflections-and-water = প্রতিফলন এবং পানি
ui-options-tab-name-tags = নাম ট্যাগ
ui-options-tab-keywords = কীওয়ার্ড
ui-options-tab-history = ইতিহাস
ui-options-tab-away-and-replies = দূরে এবং উত্তর
ui-options-tab-bars-and-windows = বার এবং উইণ্ডো
ui-options-tab-startup = আরম্ভ
ui-options-aurora-redrawn-windows = উইণ্ডো পুনরায় আঁকো
ui-options-aurora-in-the-world = বিশ্বে
ui-options-aurora-water = উত্তরায়ণ পানি
ui-options-distance-and-detail = দূরত্ব এবং বিবরণ
ui-options-shadows = ছায়া
ui-options-exposure-and-glow = এক্সপোজার এবং জ্যোৎস্না
ui-options-color-and-sharpness = রং এবং চমৎকারতা
ui-options-frames-per-second = প্রতি সেকেন্ডে ফ্রেম
ui-options-frame-limit = সীমা
ui-options-render-scale = ত্রিমাত্রিক রেন্ডার স্কেল
ui-options-render-scale-help = পৃথিবীকে কম রেজোলিউশনে প্রদর্শন করুন এবং ফ্রেমের হার উন্নত করার জন্য এটিকে আরো বড় আকারে প্রদর্শনের চেষ্টা করুন। ইন্টারফেস এবং HUDs স্পষ্টভাবে দেখানো হবে। সংরক্ষিত ছবি তাদের সম্পূর্ণ রেজুলেশন ব্যবহার করবে।
ui-options-render-scale-auto = ডিসপ্লের সাথে মিল
ui-options-render-scale-auto-help = প্রদর্শনের যৌক্তিক রেজোলিউশনে পৃথিবী আঁকো এবং এটিকে আরো বড় করে দেখাও: ২× ডিসপ্লেতে ৫০%, ১.৫×-এ ৬৭%, ১×-তে সম্পূর্ণ রেজুলেশন। ইন্টারফেস এবং HUDs স্পষ্টভাবে থাকে। Mac-এর ক্ষেত্রে ডিফল্ট হিসাবে চালু, Legacy Viewer-এর মত। শতাংশ নির্বাচন করতে এটি নিষ্ক্রিয় করুন।
ui-options-frame-limit-unfocused = ফোকাস করা না থাকলে সীমাবদ্ধ করুন
