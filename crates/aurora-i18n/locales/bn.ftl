director-capture-taking =
    আপনার পাথ রেকর্ড করা হচ্ছে: { $time }, { $views ->
        [one] { $views } প্রদর্শন
       *[other] { $views } প্রদর্শন
    }
director-capture-stop = বন্ধ করে কীফ্রেম তৈরি করুন
