        [one] { $count } ফাইল সরানো হয়েছে ।
       *[other] { $count } ফাইল সরানো হয়েছে ।
    }
ui-options-chat-logs-move-failed = ফাইল সরাতে ব্যর্থ: পূর্ববর্তী ফোল্ডারটি সংরক্ষিত রয়েছে।
ui-options-chat-logs-erase = এই অ্যাকাউন্টের ইতিহাস মুছে ফেলুন…
ui-options-chat-logs-erase-title = অ্যাকাউন্টের ইতিহাস মুছে ফেলা হবে কি?
ui-options-chat-logs-erase-text = এই গ্রিডের এই অ্যাকাউন্টের সকল আড্ডা ফাইল ডিস্ক থেকে মুছে ফেলা হবে: ইনস্ট্যান্ট বার্তা, গ্রুপ, কনফারেন্স এবং নিকটবর্তী আডডাল। এটি বাতিল করা যাবে না। অন্যান্য অ্যাকাউন্ট স্পর্শ করা হবে না। গ্রিড দ্বারা সংরক্ষিত ব্যক্তিগত আডড্ডার অনুলিপি মুছে দেওয়া হবে না: Aurora এর দ্বারা এই মুছে ফেলতে পূর্ববর্তী বার্তার প্রদর্শন বন্ধ করা হবে।
ui-options-chat-logs-erase-confirm = মুছে ফেলো
ui-options-chat-logs-no-account = এই অ্যাকাউন্টের ফোল্ডার দেখার জন্য লগ-ইন করুন।
ui-options-chat-logs-erased =
    { $count ->
        [one] { $count } ফাইল মুছে ফেলা হয়েছে ।
       *[other] { $count } ফাইল মুছে ফেলা হয়েছে ।
    }
ui-options-chat-logs-erase-failed = কিছু ফাইল মুছে ফেলা যায়নি।
ui-options-chat-logs-busy = ইতিহাস একটি ইমপোর্ট, সরানো অথবা মুছে ফেলার কাজ নিয়ে ব্যস্ত: কিছুক্ষণের মধ্যে আবার চেষ্টা করুন ।
ui-options-chat-logs-import-login = লগ- ইন করার সময় আমদানি করো
ui-options-chat-logs-import-login-help = প্রতিটি লগ-ইনকালে, উপরে সংরক্ষিত কথোপকথনের জন্য এই অ্যাকাউন্টের জন্য শেষ ইম্পোর্টের পর থেকে Legacy Viewer দ্বারা লেখা তথ্য যোগ করা হবে। এর ফাইল শুধুমাত্র পড়া যাবে। ডিফল্টভাবে সক্রিয়।
ui-options-chat-logs-import-login-off = লগ- ইন করার সময় ইম্পোর্ট করা বন্ধ করা হয়েছে, যাতে এই ইতিহাস আর ফিরে আসে না ।
ui-options-chat-logs-imported-at-login =
    Legacy প্রদর্শক থেকে আড্ডার ইতিহাস: { $count ->
        [one] { $count } বার্তা যোগ করা হয়েছে
       *[other] { $count } বার্তা যোগ করা হয়েছে
    } দুই { $files ->
        [one] { $files } কথাবার্তা।
       *[other] { $files } কথাবার্তা।
    } এটি বন্ধ করতে হলে লগ-ইন করার সময় ইম্পোর্ট নিষ্ক্রিয় করুন (পছন্দসমূহ › আড্ডা › ইতিহাস)।
ui-options-chat-logs-import = পুরোনো প্রদর্শক থেকে আমদানি করো...
ui-options-chat-logs-import-title = পুরোনো প্রদর্শক থেকে আড্ডার ইতিহাস ইম্পোর্ট করুন
ui-options-chat-logs-import-text = এই অ্যাকাউন্টের ফাইলে সময় অনুযায়ী আড্ডা যোগ করা হবে এবং বার্তাগুলি ইতিমধ্যেই উপস্থিত রয়েছে তা উপেক্ষা করা হবে, ফলে পুনরায় ইম্পোর্ট করলে শুধুমাত্র নতুন বারতা যোগ করা হয়। Legacy Viewer'র ফাইলগুলি কেবল পড়া যাবে।
ui-options-chat-logs-import-searching = Legacy Viewer-এর ইতিহাস অনুসন্ধান করা হচ্ছে…
ui-options-chat-logs-import-none = এই অ্যাকাউন্টের জন্য কোনো লেইগেসি প্রদর্শক ইতিহাস পাওয়া যায়নি। যদি এটি অন্য কোথাও থাকে, তবে তার ফোল্ডার নির্বাচন করুন।
ui-options-chat-logs-import-files =
    { $count ->
        [one] { $count } কথোপকথন ফাইল
       *[other] { $count } আড্ডা ফাইল
    }
ui-options-chat-logs-import-same = Aurora এই ফোল্ডারটি ইতিমধ্যেই ব্যবহার করছে: ইম্পোর্ট করার জন্য কিছু নেই।
ui-options-chat-logs-import-empty = এই ফোল্ডারে কোনো আড্ডা ফাইল নেই।
ui-options-chat-logs-import-choose = একটি ফোল্ডার নির্বাচন করুন…
ui-options-chat-logs-import-confirm = আমদানি
ui-options-chat-logs-importing = ইম্পোর্ট করা হচ্ছে: { $done } এর { $total } সারি
ui-options-chat-logs-imported =
    { $count ->
        [one] { $count } বার্তা যোগ করা হয়েছে
       *[other] { $count } বার্তা যোগ করা হয়েছে
    } দুই { $files ->
        [one] { $files } কথাবার্তা।
       *[other] { $files } কথাবার্তা।
    }
ui-options-chat-logs-import-reopen = যে কথোপকথনটি ইতিমধ্যেই চলছে, পরবর্তী বার যখন সেটা খোলা হবে তখন তা দেখানো হবে।
ui-options-chat-logs-import-nothing = নতুন কিছু ইম্পোর্ট করার নেই।
ui-options-chat-logs-import-failed =
    { $count ->
        [one] { $count } ফাইলটি ইম্পোর্ট করা যায়নি এবং সেটিকে যেভাবে ছিল তেমনই রেখে দেওয়া হয়েছে: পুনরায় চেষ্টা করার জন্য আবার ইম্পার্ট করুন ।
       *[other] { $count } ফাইল ইম্পোর্ট করা যায়নি এবং সেগুলোকে যেমন ছিল তেমনই রেখে দেওয়া হয়েছে: পুনরায় চেষ্টা করার জন্য আবার ইম্পার্ট করুন।
    }
ui-options-chat-logs-import-left-out =
