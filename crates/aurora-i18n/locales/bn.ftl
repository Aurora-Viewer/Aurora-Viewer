    { $count ->
        [one] এই 'কপি করা হবে না' বস্তুটি আপনার ইনভেস্টমেন্টে স্থানান্তরিত হবে, অনুলিপি করা হয়নি:
       *[other] এই { $count } 'কোন অনুলিপি নেই' বস্তুগুলো আপনার ইনভেস্টমেন্টে স্থানান্তরিত হবে, অনুলিপী করা হবে না:
    }
contents-copy-move-more =
    { $count ->
        [one] ...এবং { $count } বার্তা
       *[other] ...এবং { $count } আরও আইটেম
    }
contents-copy-requested = বিষয়বস্তু "- এ অনুলিপি করো{ $folder }"আবেদন করা হয়েছে।
