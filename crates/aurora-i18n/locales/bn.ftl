director-free-speed = গতি
director-keyframe-title = কীফ্রেম
director-keyframe-none = সম্পাদন করার জন্য টাইমলাইনে অথবা বিশ্বের একটি কীফ্রেম নির্বাচন করুন।
director-keyframe = কীফ্রেম { $number }
director-keyframe-at = কীফ্রেম { $number } এ { $time }
director-key-time = সময়
director-go-to = এখানে যাও
director-go-to-tip = ক্যামেরাটি এই কীফ্রেম-এ সরিয়ে নিন, যাতে এটির মধ্যে দিয়ে দেখতে অথবা এটিকে সংশোধন করতে পারেন। কীফ্রেমের উপর দুইবার ক্লিক করলেও একই কাজ হবে।
director-update = আপডেট
director-update-tip = বর্তমান প্রদর্শন ক্ষেত্রের সঙ্গে এই কীফ্রেমটি প্রতিস্থাপন করো ।
director-delete = মুছে ফেলো
director-path = পাথ
director-curve-smooth = বক্ররেখা
director-curve-linear = সরল রেখা
director-even-speed = ভারসাম্যপূর্ণ গতি
director-even-speed-tip = টাইমলাইনে কীফ্রেম সরিয়ে নেওয়া হবে যাতে ক্যামেরা সমগ্র পথের একই গতি বজায় রাখতে পারে। সময়কাল পরিবর্তন করা হবে না।
director-ease = সুষম শুরু ও শেষ
director-ease-tip = ক্যামেরা প্রথম কীফ্রেম থেকে বিশ্রাম ছেড়ে দেয় এবং শেষেরটিতে বিশ্রামী হয়।
director-show-path = বিশ্বের পাথ দেখাও
director-summary =
    { $count ->
        [one] { $count } কীফ্রেম
       *[other] { $count } কীফ্রেম
    } · { $seconds } s · { $meters } m
director-playback = প্লে- ব্যাক
director-start-delay = আরম্ভের বিলম্ব
director-start-delay-tip = প্রথম দৃশ্যটি ক্যামেরা চলে যাওয়ার অনেক আগে থেকেই দেখা যাচ্ছে, ইন্টারফেস ইতোমধ্যে লুকিয়ে আছে: রেকর্ডিং শুরুর সময়।
director-hide-huds = খেলার সময় HUD আড়াল করো
director-loop = লুপ
director-clear = ট্র্যাক মুছে ফেলো
director-clear-tip = ট্র্যাক মুছে ফেলো: প্রতিটি কীফ্রেম চলে যায় (প্রথমে জিজ্ঞাসা করা হয়; বাতিল করলে তারা ফিরে আসে)
director-clear-confirm = ট্র্যাক পরিষ্কার করবো?
director-clear-confirm-text =
    { $count ->
        [one] এর কীফ্রেম মুছে ফেলা হয়েছে । বাতিল করো (Ctrl+Z) এটি ফিরিয়ে আনবে ।
       *[other] এর { $count } কীফ্রেম মুছে ফেলা হয়েছে । বাতিল করো (Ctrl+Z) তাদের ফিরিয়ে আনবে ।
    }
director-clear-action = পরিষ্কার করো
director-environment = পরিবেশ
director-rewind = শুরুতে ফিরে যাও
director-play = ট্র্যাক চালাও । ইন্টারফেস আড়াল করা হয়েছে; Escape বন্ধ করে দেয় ।
director-play-needs-keys = ট্র্যাকটি চালানোর জন্য অন্তত দুইটি কীফ্রেম যোগ করুন।
director-restricted = RLVa ক্যামেরাকে সীমাবদ্ধ করে: ট্র্যাক চালানো যাবে না এবং প্রদর্শন লক করা যাবে না।
director-add-keyframe = কীফ্রেম
director-add-keyframe-tip = বর্তমান প্রদর্শনক্ষেত্রের সাথে একটি কীফ্রেম যোগ করুন: ক্যামেরা কোথায়, এটি কোথা থেকে দেখা হচ্ছে এবং এর প্রদর্শনের কোণ।
director-track-full = ট্র্যাক ভরাট হয়ে গেছে।
director-starts-in =
    { $seconds ->
        [one] শুরু হয় { $seconds } সেকেন্ড
       *[other] শুরু হয় { $seconds } সেকেন্ড
    }
director-stop-hint = বন্ধ করতে Esc
director-key-time-tip = ক্যামেরা যখন এই কীফ্রেম-এ থাকে তখন শুধুমাত্র এই কীফরেমটিই তার দুই প্রতিবেশীর মধ্যে সরে যায়।
director-span-time = অংশের সময়কাল
director-span-time-tip = পূর্ববর্তী কীফ্রেম থেকে এই ফ্রেমে ক্যামেরা প্রবেশ করার সময়। এর পরের কীফ্রেমগুলোও এর সাথে প্রবেশ করবে, যাতে অন্যান্য অংশগুলো তাদের নিজস্ব গতি বজায় রাখতে পারে।
director-span-speed = অংশের গতি
director-span-speed-tip = পূর্ববর্তী কীফ্রেম থেকে এই ফ্রেমে ক্যামেরার গড় গতি। নতুন গতি সেগমেন্টের সময়কাল পরিবর্তন করে; এর পরবর্তী কিফ্রেমগুলোও এর সাথে স্থানান্তরিত হয়।
director-span-speed-still = ক্যামেরা এই রেখার উপরে নড়াচড়া করে না: এটি শুধুমাত্র ঘুরে বা বড় আকারে প্রদর্শন করে। এর পরিবর্তে এর সময়কাল নির্ধারণ করুন।
director-duration = মোট সময়কাল
director-duration-tip = প্রতিটি অংশ একইভাবে প্রসারিত বা সংকুচিত করে: সমগ্র ট্র্যাককে ধীর অথবা দ্রুত করে।
director-keyframe-hint = টান: এটিকে সময়ের সাথে নিয়ে যাও । Shift+টান: কী- ফ্রেমের পর তাও সরিয়ে ফেলো । দুইবার ক্লিক: এতে যাও ।
director-keyframe-pick-hint = Ctrl+ক্লিক: এটিকে নির্বাচনের মধ্যে যোগ করো অথবা তা সরিয়ে নাও । Shift+ক্লিকের: এর উপরের প্রতিটি কী-ফ্রেম বেছে নাও
director-key-group = { $count } নির্বাচিত কী- ফ্রেম: এখানে যে বৈশিষ্ট্য পরিবর্তন করা হয়েছে তা তাদের সবার ক্ষেত্রে প্রযোজ্য (তাদের অবস্থান, শিরোনাম এবং সময় তাদের নিজস্ব থাকবে) ।
director-key-rest = এই কীফ্রেম- এ থামাও
director-key-rest-tip = ক্যামেরা এই কীফ্রেমটিতে থামিয়ে ধীরে ধীর করে এবং দ্রুত গতিতে অতিক্রম করার পরিবর্তে এটিকে নরমভাবে ছেড়ে দেয়। শুধুমাত্র বক্ররেখার সাথে।
director-key-lock = লক্ষ্যে প্রদর্শন লক করো
director-key-lock-tip = এই কীফ্রেমটি অন্য কীফ্রেমের এবং লাইভ ক্যামেরার যে কোন কিছুর উপর নির্ভর করে তার নিজস্ব লক। সক্রিয় হলে, ট্র্যাক চালানোর সময় এটি লক্ষ্যবস্তু দেখবে (সক্রিয় করলে টার্গেটের লক গ্রহণ করা হবে); নিষ্ক্রিয় থাকলে, ক্যামেরা যেখানে স্থাপন করা হয়েছে সেখানে তা দেখাবে।
director-key-aim = দেখছে
director-key-aim-tip = ট্র্যাকটি এই কীফ্রেমটি চালানোর সময় প্রদর্শনক্ষেত্রের মধ্যে কি দেখানো হবে। দুইটি কীফ্রেমের মাঝখানে, এটি একটি ফ্রেম থেকে পরবর্তী ফ্রমে দ্রুত পরিবর্তন করে।
director-key-aim-lock-on = লক টার্গেট: { $target }
director-key-aim-lock-off = ক্যামেরা কোথায় স্থাপন করা হয়েছে (এটি লক অনুসরণ করে, যা বন্ধ)
director-key-aim-free = যেখানে তার ক্যামেরা স্থাপন করা হয়
director-aim-joint = { $target } · { $joint }
director-key-aim-take = লক-এর লক্ষ্য ব্যবহার করো
director-key-aim-take-tip = এই কীফ্রেমটি লক- এর অধীনে নির্বাচিত লক্ষ্যবস্তুকে দেখছে, যেমনটা এখন আছে । লক পরিবর্তন বা নিষ্ক্রিয় করা হলে এটি তা ধরে রাখে ।
director-hide-pointer = খেলার সময় মাউস পয়েন্টার আড়াল করো
director-lock = লক
director-lock-on = লক্ষ্যে প্রদর্শন লক করো
director-lock-on-tip = ক্যামেরা যেখানেই সরিয়ে রাখুন না কেন, লক্ষ্যবস্তু প্রদর্শনের কেন্দ্রে থাকবে, কোন কীফ্রেম প্রয়োজন হবে না। প্রদর্শন লক করা অবস্থায় যোগ করা একটি কীফ্রেমের এই লক্ষ্যবস্থায় লক হয়ে যাবে, এমনকি আপনি পরবর্তীতে অন্য একটি নির্বাচন করলেও; প্রতিটি কীফ্রেইম তার নিজস্ব লক বজায় রাখবে, যা ট্র্যাক ট্যাবের তার সারিতে নির্ধারিত হবে।
director-lock-target = লক্ষ্য
director-lock-own = আমার আভাটা
director-lock-avatar = আরেকটা অ্যাভাটার
director-lock-object = একটি বস্তু
director-lock-pick-own = আমার আভাটা
director-lock-pick-focus = ক্যামেরা ফোকাস
director-lock-pick-focus-tip = ক্যামেরা ফোকাস করার জন্য Alt+একটি অবতার বা বস্তুতে ক্লিক করুন, তারপর এই বাটনটি চাপুন: প্রদর্শন সেই অবতার (যদিও তা যা পরে) অথবা ঐ বস্তুর উপর লক করা হবে।
director-lock-joint = মূল অংশ
director-lock-smoothing = মসৃণ করা হচ্ছে
director-lock-smoothing-tip = লক্ষ্যবস্তুকে পেতে প্রদর্শনক্ষেত্র কতক্ষণ সময় নেয়। ০ হলে এটি প্রতিটি নড়াচড়া অনুসরণ করে, যেমন নাচের প্রতিটি ধাপ; উচ্চতর হলে ক্যামেরা অপারেটরদের মত অনুসরণ করা হয়।
director-lock-lost = লক্ষ্যবস্তু দেখা যাচ্ছে না: যেখানে তা দেখা যায়, সেখানে দৃষ্টিভঙ্গি মুক্ত।
director-joint-head = মাথা
director-joint-neck = গলায়
director-joint-chest = বুক
director-joint-pelvis = পেলভিস
director-joint-left-hand = বাম হাত
director-joint-right-hand = ডান হাত
director-picture = ছবি
director-format = ফরম্যাট
director-format-tip = চলচ্চিত্রের অনুপাত। আপনি সম্পাদনা করার সময়, ফ্রেমটি পরিমাপ করা হয় এবং এর বাইরে যা আছে তা অন্ধকার করা হয়; ট্র্যাক চালানোর সময়, কালো বারে এটি আড়াল করা হয়।
director-format-window = উইণ্ডো
director-thirds = তৃতীয়াংশের নিয়ম
director-delete-tip = নির্বাচিত কীফ্রেম মুছে ফেলো (মুছে ফেলা)
director-undo = বাতিল করো (Ctrl+Z)
director-redo = পুনরায় করো (Ctrl+Y)
director-isolate-empty = ফাঁকা পটভূমি
director-isolate-empty-tip = কোন আকাশ, মাটি, পানি বা মেঘ নেই যেটা দেখানো হয়েছে: একটি সাদা পটভূমি ছবির বিষয়বস্তুকে বাদ দিয়েছে।
director-key-color = পটভূমির রং
director-key-color-tip = ফাঁকা পটভূমিতে একই রঙের একটি প্লেট ব্যবহার করে ভর্তি করো, প্রথমে সবুজ: একটি সবুজের পর্দা, চলচ্চিত্র সম্পাদনা করার সময় কিউব আউট করতে । একটি রং বেছে নাও বিষয়টি পরবে না ।
director-record = রেকর্ড করা হচ্ছে
director-record-looking = ffmpeg অনুসন্ধান করা হচ্ছে...
director-record-missing = ffmpeg ইনস্টল করা নেই: এটি একটি মুক্ত প্রোগ্রাম যা চলচ্চিত্র এনকোড করে।
director-record-missing-hint = এটি ইনস্টল করুন (উইন্ডোজ টার্মিনালে: winget install ffmpeg), তারপর “আবার দেখুন” চাপুন; অথবা আপনার যদি ইতিমধ্যেই একটি ফাইল থাকে তাহলে তা বেছে নিন।
director-record-site = ডাউনলোড পৃষ্ঠা
director-record-choose = ffmpeg নির্বাচন করুন…
director-record-again = আবার দেখো
director-record-found = এনকোডার: { $name }
director-record-format = ফরম্যাট
director-record-format-mp4 = MP4 (H.264): যেখানেই চালান
director-record-format-prores = MOV (ProRes 422): সম্পাদনের জন্য
director-record-format-prores-alpha = MOV (ProRes 4443): স্বচ্ছ পটভূমি
director-record-format-webm = ওয়েবএম (VP9)
director-record-format-lossless = MKV (FFV1): ক্ষতিবিহীন
director-record-fps = প্রতি সেকেন্ডে ফ্রেম
director-record-quality = গুণমান
director-record-quality-light = হালকা
director-record-quality-good = ভাল
director-record-quality-best = সেরা
