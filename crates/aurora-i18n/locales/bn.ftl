anti-spam-blocked-burst =
    { $count ->
        [one] { $count } এই সেশনের জন্য অ্যান্টি- স্প্যাম দ্বারা উৎস অবরোধ করা হয়েছে ({ $kinds }) পছন্দ > সুরক্ষা > অ্যান্টি- স্প্যাম- এ ব্লক ব্যবস্থাপনা করুন ।
       *[other] { $count } এই সেশনের জন্য অ্যান্টি- স্প্যাম দ্বারা অবরোধকৃত উৎস ({ $kinds }) পছন্দ > সুরক্ষা > অ্যান্টি- স্প্যাম- এ ব্লক ব্যবস্থাপনা করুন ।
    }
