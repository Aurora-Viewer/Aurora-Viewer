blender-live-linkset-counts =
    { $objects ->
        [one] { $objects } বস্তু
       *[other] { $objects } বস্তু
    } · { $prims ->
        [one] { $prims } প্রাথমিক
       *[other] { $prims } মৌলিক সংখ্যা
    } · { $triangles ->
        [one] { $triangles } ত্রিভুজ
       *[other] { $triangles } ত্রিভুজ
    }
