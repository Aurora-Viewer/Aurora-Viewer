   *[other] Вилучено { $count } рядка
    }
money-tracker-undo = Скасувати
money-tracker-always = Вести облік і тоді, коли вікно закрите
money-tracker-always-help = Завжди відстежувати платежі, навіть коли облік коштів закритий.
money-tracker-copy-all = Копіювати все (CSV)
money-tracker-copy-some = Копіювати { $count } (CSV)
money-tracker-clear = Очистити
money-tracker-quoted = «{ $text }»
money-tracker-kind-sale = Продаж об'єкта
money-tracker-kind-purchase = Купівля об'єкта
money-tracker-kind-gift = Подарунок
money-tracker-kind-pay-object = Оплата об'єкту
money-tracker-kind-object-pays = Сплачено об'єктом
money-tracker-kind-land = Земля
money-tracker-kind-land-pass = Перепустка на землю
money-tracker-kind-land-deed = Передача землі
money-tracker-kind-group-create = Створення групи
money-tracker-kind-group-join = Вступний внесок групи
money-tracker-kind-upload = Плата за вивантаження
money-tracker-kind-classified = Оголошення
money-tracker-kind-other = Операція
money-tracker-system = Сплачено системі
money-tracker-legacy-time = Час
money-tracker-legacy-name = Ім'я
money-tracker-legacy-amount = Сума
