money-tracker-all = Усі
money-tracker-tab-received = Отримано
money-tracker-tab-paid = Сплачено
money-tracker-empty = Платежів ще немає.
money-tracker-empty-help = Тут з'являтимуться L$, які ви отримуєте й сплачуєте.
money-tracker-profile = Переглянути профіль
money-tracker-group-profile = Профіль групи
money-tracker-pay = Заплатити…
money-tracker-copy-selection = Копіювати вибране (CSV)
money-tracker-remove = Вилучити зі списку
money-tracker-removed = { $count ->
