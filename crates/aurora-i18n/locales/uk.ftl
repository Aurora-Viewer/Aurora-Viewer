anti-spam-blocked = Антиспам заблокував категорію «{ $kind }» від { $source } на цей сеанс. Керуйте блокуваннями в «Налаштування › Захист › Антиспам».
anti-spam-blocked-burst = { $count ->
    [one] Антиспам заблокував { $count } джерело на цей сеанс ({ $kinds }). Керуйте блокуваннями в «Налаштування › Захист › Антиспам».
    [few] Антиспам заблокував { $count } джерела на цей сеанс ({ $kinds }). Керуйте блокуваннями в «Налаштування › Захист › Антиспам».
    [many] Антиспам заблокував { $count } джерел на цей сеанс ({ $kinds }). Керуйте блокуваннями в «Налаштування › Захист › Антиспам».
   *[other] Антиспам заблокував { $count } джерела на цей сеанс ({ $kinds }). Керуйте блокуваннями в «Налаштування › Захист › Антиспам».
}
