# Director — capture and animations
director-capture = الطريق باليد
director-capture-start = تسجيل طريقي
director-capture-start-tip = طيران الكاميرا كما تريد أن يتم تصويرها (الكاميرا البديلة، الكاميرا الحرة أو flycam): ويبقى الرؤية عشرين مرة في الثانية، ووقف تحويلها إلى إطارات رئيسية بالسرعة التي طارت.
director-capture-taking =
    تسجيل مسارك: { $time }, { $views ->
        [one] { $views } العرض
       *[other] { $views } آراء
    }
