# Director — capture and animations
director-capture = Laluan secara manual
director-capture-start = Rekam jalanku
director-capture-start-tip = Menerbangkan kamera seperti yang Anda inginkan difilmkan (alt-kamera, kamera bebas atau flycam): pandangan dipelihara dua puluh kali per detik, dan Stop mengubahnya menjadi keyframes pada kecepatan yang Anda terbang.
director-capture-taking =
    Menyalin jalurmu: { $time }, { $views ->
        [one] { $views } tampilan
       *[other] { $views } tampilan
    }
director-capture-stop = Hentikan dan buat keyframes
director-capture-stop-tip = Laluan menjadi keyframes setelah akhir trek, pada tempo yang Anda terbangkan. Ctrl+Z mengambilnya kembali.
director-capture-cancel-tip = Tinggalkan jalur ini (Escape).
director-capture-detail = Detail
director-capture-detail-tip = Seberapa dekat keyframes mengikuti jalur Anda: lebih banyak detil mempertahankan gerakannya yang lebih kecil, dengan lebih banyak keyframe.
director-capture-hint = Laluan Anda ditambahkan setelah akhir dari trek, atau menjadi trek ketika itu kosong.
director-capture-done =
    Jalanmu menjadi { $count ->
        [one] { $count } keyframe
       *[other] { $count } keyframes
    } di atas { $time }.
director-capture-short = Jalur terlalu pendek untuk dimainkan: rekaman sedikit lebih lama.
director-capture-full = Jalur tidak memiliki ruang tersisa untuk jalur ini.
director-capture-dropped = Lalu lintas diturunkan: Direktur ditutup, teleport dimulai atau RLVa membatasi kamera.
director-capture-restricted = RLVa membatasi kamera: tidak ada jalur yang dapat direkam.
director-key-anim = Animasi
director-key-anim-none = Tidak ada
director-key-anim-tip = Sebuah animasi dari inventarisasi Anda yang dimainkan oleh avatar Anda ketika trek melewati keyframe ini (atau jatuhkan satu di sini dari inventaris). Apapun yang dimulai oleh trek akan berhenti saat pemutaran berakhir.
director-key-anim-missing = { $name } (hilang)
director-key-anim-missing-tip = Animasi ini tidak lagi ada dalam inventarisasi Anda: pemutaran melewatinya.
director-key-anim-clear = Tidak ada animasi di sini
director-key-anim-until = Sampai
director-key-anim-until-tip = Dimana animasi berhenti: pada keyframe berikutnya, atau ketika pemutaran berakhir.
director-key-anim-end = Akhir pemutaran
director-key-anim-stops = Berhenti
director-key-anim-stops-tip = Sebuah animasi yang keyframe sebelumnya dimulai berhenti di sini.
director-key-anim-stops-clear = Biarkan ia bermain di
director-key-lens-time = Lensa dan waktu siang
director-key-aperture = Bukaan
director-key-aperture-tip = Kedalaman bidang keyframe ini; antara dua keyframe berubah dengan mulus.
director-key-focus = Fokus
director-key-focus-tip = Jarak keyframe ini difokuskan pada, bukan trek (target, atau jarak fokusnya).
director-key-hour = Jam harian
director-key-hour-tip = Matahari pada keyframe ini, hanya dalam pandangan Anda sendiri: tidak ada yang dikirim ke wilayah. Antara dua keyframe bergerak dengan mulus; langit Anda sendiri kembali ketika pemutaran berakhir.
director-key-track-value = Nilai trek
director-key-live = Tingkat
director-key-set = Set
director-key-set-tip = Berikan keyframe ini nilai sendiri.
director-key-unset = Kembali ke nilai trek
director-key-unset-live = Kembali ke langit hidup
director-title = Direktur
director-tab-track = Trek
director-tab-camera = Kamera
director-tab-look = Lihat
director-tab-output = Keluaran
director-tab-library = Pustaka
director-tab-filters = Filter
director-filters-note = Filter dan LUT jendela Foto: satu tumpukan untuk foto dan film. Trek direkam dan dihasilkan dengannya.
director-freeze-world-tip = Seperti pada jendela Foto: avatar, animasi dan segala sesuatu yang bergerak tetap diam, kamera tetap bebas. Sebuah trek yang dimainkan melalui dunia beku berputar di sekitar momen diam.
director-thumb-missing-tip = Belum ada gambar dari tampilan ini: gambar ini diambil ketika keyframe diletakkan atau diperbarui, pada Go to, dan saat trek dimainkan melaluinya.
director-camera = Kamera
director-lens = Sudut pandang
director-roll = Daftar
director-roll-reset = Meningkatkan tampilan
director-free-camera = Kamera bebas
director-free-camera-tip = Kamera meninggalkan avatar: terbang dengan tombol gerakan, lihat sekeliling dengan tombol tetikus kanan.
director-free-speed = Kecepatan
director-keyframe-title = Keyframe
director-keyframe-none = Pilih keyframe pada timeline atau di dunia untuk disunting.
director-keyframe = Keyframe { $number }
director-keyframe-at = Keyframe { $number } pada { $time }
director-key-time = Waktu
director-go-to = Pergi ke
director-go-to-tip = Pindahkan kamera ke keyframe ini, untuk melihat melaluinya atau mengaturnya. Klik dua kali pada keyframe melakukan hal yang sama.
director-update = Perbarui
director-update-tip = Ganti keyframe ini dengan tampilan saat ini.
director-delete = Hapus
director-path = Path
director-curve-smooth = Kurva
director-curve-linear = Garis lurus
director-even-speed = Kecepatan yang sama
director-even-speed-tip = Memindahkan keyframes pada garis waktu sehingga kamera mempertahankan kecepatan yang sama sepanjang seluruh jalur. Durasi tidak berubah.
director-ease = Awal dan akhir yang halus
director-ease-tip = Kamera meninggalkan keyframe pertama dari istirahat dan datang untuk beristirahat pada yang terakhir.
director-show-path = Tunjukkan jalan di dunia
director-summary =
    { $count ->
        [one] { $count } keyframe
       *[other] { $count } keyframes
    } · { $seconds } s · { $meters } m
director-playback = Putar
director-start-delay = Penundaan mulai
director-start-delay-tip = Tampilan pertama dilaksanakan ini lama sebelum kamera pergi, dengan antarmuka sudah tersembunyi: waktu untuk memulai rekaman.
director-hide-huds = Sembunyikan HUD saat bermain
director-loop = Loop
director-clear = Kosongkan jalurnya
director-clear-tip = Kosongkan trek: setiap keyframe pergi (diminta pertama; Undo membawa mereka kembali)
director-clear-confirm = Menghapus jejak?
director-clear-confirm-text =
    { $count ->
        [one] Keyframe-nya dihapus. Ulangi (Ctrl+Z) membawanya kembali.
