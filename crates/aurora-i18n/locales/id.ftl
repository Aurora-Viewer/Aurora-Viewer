    }
director-clear-action = Bersihkan
director-environment = Lingkungan
director-rewind = Kembali ke awal
director-play = Putar trek. Antarmuka tersembunyi; Escape berhenti.
director-play-needs-keys = Tambahkan setidaknya dua keyframe untuk memainkan trek.
director-restricted = RLVa membatasi kamera: trek tidak dapat dimainkan dan tampilan tidak dapat dikunci.
director-add-keyframe = Keyframe
director-add-keyframe-tip = Tambahkan keyframe dengan tampilan saat ini: di mana kamera berada, di mana ia terlihat dan sudut pandangnya.
director-track-full = Jalurnya penuh.
director-starts-in =
    { $seconds ->
        [one] Bermula pada { $seconds } detik
       *[other] Bermula pada { $seconds } detik
    }
director-stop-hint = Esc untuk berhenti
director-key-time-tip = Ketika kamera berada pada keyframe ini. Hanya keyframe yang bergerak, antara dua tetangganya.
director-span-time = Durasi Segmen
director-span-time-tip = Waktu yang dibutuhkan kamera dari keyframe sebelumnya ke keyframe ini. Keyframe setelahnya bergerak bersama dengannya, sehingga segmen lain menjaga kecepatan mereka sendiri.
director-span-speed = Kecepatan Segmen
director-span-speed-tip = Kecepatan rata-rata kamera dari keyframe sebelumnya ke yang ini. Kelajuan baru mengubah durasi segmen; keyframe setelahnya bergerak dengannya.
director-span-speed-still = Kamera tidak bergerak pada segmen ini: hanya berputar atau memperbesar. Tetapkan durasinya sebagai gantinya.
director-duration = Total durasi
director-duration-tip = Memperpanjang atau memperpendek setiap segmen sama: seluruh trek lebih lambat atau lebih cepat.
director-keyframe-hint = Seret: pindahkan dalam waktu. Shift + seret: keyframe setelah bergerak juga. Klik ganda: pergi kenya.
director-keyframe-pick-hint = Ctrl + klik: tambahkan ke pemilihan atau buang. Shift + click: pilih setiap keyframe sampai padanya.
director-key-group = { $count } keyframes yang dipilih: pengaturan yang diubah di sini akan masuk ke semua keyframe (tempat, judul dan waktunya tetap sama).
director-key-rest = Berhenti pada keyframe ini
director-key-rest-tip = Kamera memperlambat untuk berhenti pada keyframe ini dan meninggalkannya dengan lembut, bukannya melewatinya dengan kecepatan. hanya dengan kurva.
director-key-lock = Kunci tampilan pada target
director-key-lock-tip = Kunci keyframe ini sendiri, apapun keyframe lain dan kamera langsung. Diaktifkan, melihat targetnya ketika trek dimainkan (target kunci, diambil saat diaktifkan); dimatikan, di mana kameranya diletakkan.
director-key-aim = Melihat
director-key-aim-tip = Apa yang dilihat oleh tampilan ketika trek memainkan keyframe ini. Di antara dua keyframe, ia berputar dengan mulus dari apa yang dilihat satu ke apa yang dilakukan berikutnya.
director-key-aim-lock-on = Target kunci: { $target }
director-key-aim-lock-off = Di mana kameranya diletakkan (ia mengikuti kunci, yang dimatikan)
director-key-aim-free = Dimana kameranya diletakkan
director-aim-joint = { $target } · { $joint }
director-key-aim-take = Gunakan target kunci
director-key-aim-take-tip = Keyframe ini melihat target yang dipilih di bawah Kunci, seperti sekarang. Ia mempertahankannya ketika kunci mengubah target atau dimatikan.
director-hide-pointer = Sembunyikan kursor tetikus saat bermain
director-lock = Kunci
director-lock-on = Kunci tampilan pada target
director-lock-on-tip = Target tetap berada di tengah tampilan dimanapun Anda memindahkan kamera, tanpa keyframe yang diperlukan. Keyframe yang ditambahkan saat tampilan terkunci akan terkuncng pada target ini, bahkan jika Anda memilih keyframe lain setelahnya; setiap keyframe menyimpan kuncinya sendiri, ditetapkan dalam barisnya pada tab Track.
director-lock-target = Target
director-lock-own = Avatarku
director-lock-avatar = Avatar lain
director-lock-object = Sebuah objek
director-lock-pick-own = Avatarku
director-lock-pick-focus = Fokus kamera
director-lock-pick-focus-tip = Alt + klik avatar atau objek untuk fokus kamera padanya, lalu tekan tombol ini: tampilan terkunci pada avatar itu (bahkan melalui apa yang ia pakai) atau pada objek itu.
director-lock-joint = Bagian tubuh
director-lock-smoothing = Mencelupkan
director-lock-smoothing-tip = Berapa lama waktu yang dibutuhkan tampilan untuk mengejar target. Pada 0 ia mengikuti setiap gerakan, termasuk setiap langkah tarian; lebih tinggi, ia mengikuti seperti operator kamera.
director-lock-lost = Sasaran tidak terlihat: di mana ia dilihat, pandangannya bebas.
director-joint-head = Kepala
director-joint-neck = Leher
director-joint-chest = dada
director-joint-pelvis = Pelvis
director-joint-left-hand = Tangan kiri
director-joint-right-hand = Tangan kanan
director-picture = Gambar
director-format = Format
director-format-tip = Proporsi film. Ketika Anda mengedit, bingkai digambarkan dan apa yang berada di luarnya menjadi gelap; ketika trek dimainkan, bar hitam menyembunyikannya.
director-format-window = Jendela
director-thirds = Aturan ketiga
director-delete-tip = Hapus keyframe yang dipilih (Hapus)
director-undo = Batalkan (Ctrl+Z)
director-redo = Ulangi (Ctrl+Y)
director-isolate-empty = Latar belakang kosong
director-isolate-empty-tip = Tidak ada langit, tanah, air atau awan di sekitar apa yang ditampilkan: latar belakang sederhana untuk memotong subjek dari film.
director-key-color = Warna latar belakang
director-key-color-tip = Mengisi latar belakang kosong dengan satu warna datar, hijau pada awalnya: layar hijau, untuk mengekspos saat mengedit film. Pilih warna yang subjek tidak memakainya.
director-record = Menyalin
director-record-looking = Mencari ffmpeg...
director-record-missing = ffmpeg tidak terpasang: ini adalah program gratis yang mengenkode film.
director-record-missing-hint = Pasangnya (dalam terminal Windows: winget install ffmpeg), lalu tekan "Lihat lagi"; atau pilih berkasnya jika Anda sudah memilikinya.
director-record-site = Muat turun halaman
director-record-choose = Pilih ffmpeg…
director-record-again = Lihat lagi
director-record-found = Encoder: { $name }
director-record-format = Format
director-record-format-mp4 = MP4 (H.264): dimainkan dimanapun
director-record-format-prores = MOV (ProRes 422): untuk penyuntingan
director-record-format-prores-alpha = MOV (ProRes 4443): latar belakang transparan
director-record-format-webm = WebM (VP9)
director-record-format-lossless = MKV (FFV1): tanpa kehilangan
director-record-fps = Frame per detik
director-record-quality = Kualitas
director-record-quality-light = Cahaya
director-record-quality-good = Bagus
director-record-quality-best = Terbaik
director-record-alpha-tip = Dengan Isolate pada latar belakang kosong, apa yang ditinggalkan kosong tetap transparan dalam film.
director-record-no-sound = Film ini tidak memiliki suara.
director-record-start = Rekaman
director-record-stop = Hentikan rekaman
director-record-tip = Dengan trek: mainkan dan filmkan, sampai berakhir. Tanpa trek: filmkan tampilan hingga ditekan lagi. Film adalah tampilan 3D saja, tanpa antarmuka.
director-record-unavailable = ffmpeg diperlukan untuk merekam: lihat Rekaman di jendela Direktur.
director-record-recording = Menyalin { $time }
director-record-finishing = Menyelesaikan berkas...
director-record-saved = Film disimpan: { $name }
director-record-failed = Film ini tidak bisa ditulis: { $why }
director-record-reveal = Tampilkan dalam foldernya
director-record-no-encoder = ffmpeg ini tidak dapat menulis format tersebut: pilih format lain.
director-shake = Kamera genggam
director-shake-tip = Ketika lagu dimainkan, kamera bergerak dan berputar sedikit di sekitar jalurnya, seperti yang dipegang dengan tangan. 0: kamera stabil.
director-dof = Kedalaman bidang
director-dof-tip = Lensa sutradara sendiri: tajam pada target kunci (atau pada jarak yang ditetapkan), kabur sebelum dan sesudahnya.
director-dof-aperture = Bukaan
director-dof-focus = Jarak fokus
director-dof-on-target = Fokus pada target kunci.
director-tracks = Trek yang disimpan
director-track-name = Nama trek ini
director-track-save = Simpan
director-track-load = Muatkan trek ini (yang sedang disunting diganti; Ctrl+Z membawanya kembali)
director-track-none = Belum ada trek yang disimpan.
director-track-saved = Disimpan: { $name }
director-track-loaded = Dimuat: { $name }
director-track-failed = Berkas trek tidak dapat digunakan: { $why }
director-track-bad-name = Berikan trek nama pertama.
# Director — shots
director-shots = Shots
director-shot = Shot
director-shot-orbit = Orbit
director-shot-orbit-tip = Kamera bergerak mengelilingi pusat, melihatnya, dari di mana ia sekarang.
director-shot-dolly-zoom = Dolly zoom
director-shot-dolly-zoom-tip = Kamera mendekat ke pusat (atau mundur) sementara lensa melebar (atau menyempit): subjek mempertahankan ukurannya, latar belakang meregang atau tertutup. Efek vertigo.
director-shot-crane = Crane up
director-shot-crane-tip = Kamera naik lurus ke atas, masih melihat di pusat.
director-shot-truck = Melacak
director-shot-truck-tip = Kamera bergeser ke sisi, terbalik seperti itu.
director-shot-push-in = Tolak masuk.
director-shot-push-in-tip = Kamera bergerak maju sepanjang pandangan, tidak pernah melewati pusat.
director-shot-pull-out = Tarik keluar
director-shot-pull-out-tip = Kamera bergerak mundur sepanjang pandangan.
director-shot-fly-over = Fly-over
director-shot-fly-over-tip = Kamera melewati pusat dan ke sisi lain, melihat ke depan dan ke bawah.
director-shot-arc = Arc
director-shot-arc-tip = Seberapa jauh di sekitar pusat kamera pergi: 360 ° adalah satu putaran.
director-shot-duration = Durasi
director-shot-duration-tip = Detik-detik tembakan berlangsung.
director-shot-distance = Jarak
director-shot-distance-tip = Meter kamera bergerak.
director-shot-rise = Bangun.
director-shot-rise-tip = Meter kamera naik.
director-shot-over = Tinggi di atas
director-shot-over-tip = Meter di atas pusat kamera melewati (di atas tinggi kamera sendiri ketika lebih tinggi).
director-shot-direction = Arah
director-shot-closer = Lebih dekat.
director-shot-farther = Jauh
director-shot-left = Kiri
director-shot-right = Baik
director-shot-ccw = Berlawanan arah jarum jam
director-shot-cw = Sejajar jam
director-shot-around = Pusat
director-shot-around-target = Target kuncinya
director-shot-around-focus = Fokus kamera
director-shot-around-tip = Apa yang ditembak berputar atau melihat: target kunci saat kuncinya diaktifkan dan terlihat, jika tidak fokus kamera (di depan kamera bebas atau flycam, pada kedalaman jarak medan).
director-shot-add = Setelah trek
director-shot-replace = Ganti trek
director-shot-make = Buat tembakan
director-shot-make-tip = Meletakkan keyframes dari gambar dari tampilan saat ini, setelah keyframe terakhir trek (kamera terbang dari itu ke gambar) atau di tempat trek. Keyframes seperti yang lain setelahnya; Ctrl+Z mengambil kembali seluruh gambar.
director-shot-no-room = Tidak ada ruang untuk foto ini dari sini: kamera berada di pusatnya, atau lensa sudah pada batasnya.
director-shot-full = Jalur tidak memiliki ruang untuk ini banyak keyframes lebih.
director-shot-too-long = Jalur ini akan berlangsung lebih dari satu jam.
director-shot-made = Tembak diletakkan: { $count } keyframes, { $seconds } s. Play memainkannya dari keyframe pertamanya.
director-shot-more = Lebih banyak pilihan
director-shot-radius = Radius
director-shot-radius-tip = Jarak orbit dari pusat, meter. live: kamera sendiri, sehingga orbit dimulai di mana ia adalah.
director-shot-height = Tinggi
director-shot-height-tip = Ketinggian orbit di atas pusat, meter.
director-shot-live = Tingkat: { $value } m
director-shot-set = Tetapkan nilainya sendiri
director-shot-reset-live = Kembali ke nilai hidup
director-shot-climb = Pendakian
director-shot-climb-tip = Meter kamera naik (atau turun) dari orbit awal ke akhir: sebuah spiral.
director-shot-travel = Pergi dengan target
director-shot-travel-tip = Keyframes tembakan bergerak dengan target kunci: orbit di sekitar penari yang berjalan tetap di sekitar mereka.
director-shot-travel-off = Hanya dengan kunci di dan targetnya dalam pandangan.
director-key-ease = Meringankan
director-key-ease-tip = Bagaimana kamera memulai dan menghentikan pada jalan ke keyframe ini dari yang sebelumnya. Jalur dan waktunya tetap; akhir yang tidak diringankan mempertahankan kecepatan kurva.
director-ease-linear = Linear
director-ease-in = Perlahan masuk.
director-ease-out = Perlahan-lahan keluar
director-ease-in-out = Mudah masuk dan keluar
director-key-dolly-zoom = Dolly zoom
director-key-dolly-zoom-tip = Dalam perjalanan ke keyframe ini, lensa berubah dengan jarak sehingga subjek di depan mempertahankan ukurannya: beri dua keyframe lensa mereka, kamera bergerak lurus menuju subjek atau menjauh dari itu.
director-key-travel = Pergi dengan targetnya
director-key-travel-tip = Keyframe ini mempertahankan posisinya di samping targetnya saat target bergerak (sepanjang arah dunia), bukannya tetap di mana ia diletakkan. Update meletakkannya lagi dari tampilan saat ini.
director-key-travel-none = Keyframe ini tidak melihat target: beri target kunci pertama.
# Director — montage and tracks
director-zoom-in-tip = Zum pada garis waktu (Ctrl + roda tetikus)
director-zoom-out-tip = Zum keluar (Ctrl + roda tetikus). Tidak tersedia: seluruh trek sudah ditampilkan.
director-zoom-fit-tip = Tampilkan seluruh trek. Tidak tersedia: sudah ditampilkan.
director-thumbnail-tip = Tampilan keyframe ini. Klik: pilihnya. Klik ganda: pergi ke sana (keyframe tanpa gambar mendapatkan satu disana).
director-more-options = Lebih banyak pilihan
director-library-import = Impor...
director-library-import-tip = Tambahkan trek atau montase dari berkas yang dibagikan seseorang, ke yang disimpan (tidak ada yang diganti).
director-library-export = Eksport...
director-library-export-tip = Simpan trek yang sedang disunting ke berkas pilihan Anda, untuk dibagikan.
director-library-export-empty = Trek belum memiliki keyframe.
director-library-export-name = trek
director-library-busy = Tunggu berkas untuk dibaca atau ditulis.
director-library-save-tip = Simpan trek yang sedang disunting dengan nama ini.
