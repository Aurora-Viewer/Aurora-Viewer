  <library_geometries><geometry id="alpha-sort" name="Alpha Sort - one unrigged mesh, three faces"><mesh>
    <source id="positions"><float_array id="positions-array" count="36">-1 -0.3 -1 1 -0.3 -1 1 -0.3 1 -1 -0.3 1 -1 0 -1 1 0 -1 1 0 1 -1 0 1 -1 0.3 -1 1 0.3 -1 1 0.3 1 -1 0.3 1</float_array>
      <technique_common><accessor source="#positions-array" count="12" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
    <source id="normals"><float_array id="normals-array" count="6">0 -1 0 0 1 0</float_array>
      <technique_common><accessor source="#normals-array" count="2" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
    <source id="uv"><float_array id="uv-array" count="8">0 0 1 0 1 1 0 1</float_array>
      <technique_common><accessor source="#uv-array" count="4" stride="2"><param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common></source>
    <vertices id="vertices"><input semantic="POSITION" source="#positions"/></vertices><triangles count="4" material="material-0">
          <input semantic="VERTEX" source="#vertices" offset="0"/>
          <input semantic="NORMAL" source="#normals" offset="1"/>
          <input semantic="TEXCOORD" source="#uv" offset="2" set="0"/><p>0 0 0 1 0 1 2 0 2 0 0 0 2 0 2 3 0 3 0 1 0 2 1 2 1 1 1 0 1 0 3 1 3 2 1 2</p></triangles><triangles count="4" material="material-1">
