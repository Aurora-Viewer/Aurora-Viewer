          <input semantic="NORMAL" source="#normals" offset="1"/>
          <input semantic="TEXCOORD" source="#uv" offset="2" set="0"/><p>4 0 0 5 0 1 6 0 2 4 0 0 6 0 2 7 0 3 4 1 0 6 1 2 5 1 1 4 1 0 7 1 3 6 1 2</p></triangles><triangles count="4" material="material-2">
          <input semantic="VERTEX" source="#vertices" offset="0"/>
          <input semantic="NORMAL" source="#normals" offset="1"/>
          <input semantic="TEXCOORD" source="#uv" offset="2" set="0"/><p>8 0 0 9 0 1 10 0 2 8 0 0 10 0 2 11 0 3 8 1 0 10 1 2 9 1 1 8 1 0 11 1 3 10 1 2</p></triangles>
